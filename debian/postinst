#!/bin/bash
set -e

case "$1" in
configure)
    # Persistent journald (FR-31)
    mkdir -p /etc/systemd/journald.conf.d
    cat >/etc/systemd/journald.conf.d/00-dynavlan-persistent.conf <<'JEOF'
# Installed by dynavlan (FR-31): guarantee the journal survives reboot.
[Journal]
Storage=persistent
JEOF
    mkdir -p /var/log/journal
    systemd-tmpfiles --create --prefix /var/log/journal >/dev/null 2>&1 || true
    systemctl restart systemd-journald 2>/dev/null || true

    # Migration from install.sh: it placed units in /etc/systemd/system/ which
    # shadows the package copies in /lib/systemd/system/. Remove the old ones.
    for unit in dynavlan.service dynavlan-rescan.service dynavlan.timer; do
        if [ -f "/etc/systemd/system/$unit" ] && [ -f "/lib/systemd/system/$unit" ]; then
            rm -f "/etc/systemd/system/$unit"
        fi
    done

    # Migration: PER_VLAN_MAC was a reserved, never-implemented key, removed in
    # 0.4.3. It is no longer allowlisted, so an uncommented PER_VLAN_MAC= line in
    # an existing conffile would now refuse the whole config load (fail-to-no-op).
    # Neutralize any such line in place. Idempotent; a stock (commented) template
    # and a fresh install are unaffected.
    if [ -f /etc/dynavlan.conf ]; then
        sed -i -E 's/^([[:space:]]*)(PER_VLAN_MAC[[:space:]]*=)/\1# (removed in 0.4.3) \2/' /etc/dynavlan.conf
    fi

    # Reload units and render timer interval
    systemctl daemon-reload
    /usr/local/sbin/dynavlan --reconfigure 2>/dev/null || true

    if [ -z "$2" ]; then
        # First install ($2 empty): enable both for next boot; never start (an
        # install must not trigger a network change).
        systemctl enable dynavlan.service 2>/dev/null || true
        systemctl enable dynavlan.timer 2>/dev/null || true
    else
        # Upgrade: restore the operator's EXACT prior enable/active state (captured
        # by prerm), never re-arm a unit they deliberately disabled. If the state
        # file is missing (upgrade FROM a pre-H3 package whose prerm did not record
        # it), fall back to LIVE state: prerm's `systemctl stop` clears neither
        # unit's enablement, so is-enabled still reflects the operator's choice and
        # we must not re-enable OR start a disabled unit. The prior RUNNING state is
        # unrecoverable in that transitional case (the timer is already stopped), so
        # infer it from enablement: an enabled timer is assumed to have been running
        # (preserve-running), a disabled timer is never started - tmr_active follows
        # tmr_enabled. Hardware-validated (L3-37): a disabled+stopped timer stays
        # disabled AND inactive across the transitional upgrade.
        systemctl is-enabled --quiet dynavlan.service 2>/dev/null && svc_enabled=1 || svc_enabled=0
        systemctl is-enabled --quiet dynavlan.timer   2>/dev/null && tmr_enabled=1 || tmr_enabled=0
        tmr_active="$tmr_enabled"
        [ -f /run/dynavlan/upgrade-state ] && . /run/dynavlan/upgrade-state

        if [ "${svc_enabled:-1}" = 1 ]; then
            systemctl enable dynavlan.service 2>/dev/null || true
        else
            systemctl disable dynavlan.service 2>/dev/null || true
        fi
        if [ "${tmr_enabled:-1}" = 1 ]; then
            systemctl enable dynavlan.timer 2>/dev/null || true
        else
            systemctl disable dynavlan.timer 2>/dev/null || true
        fi
        if [ "${tmr_active:-1}" = 1 ]; then
            systemctl start dynavlan.timer 2>/dev/null || true
        fi

        rm -f /run/dynavlan/upgrade-state
    fi
    ;;
esac

#DEBHELPER#
exit 0
