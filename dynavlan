#!/usr/bin/env bash
#
# dynavlan - self-configuring VLAN provisioning for headless Linux monitoring appliances.
#
# Discovers active tagged VLANs on the trunk and brings each up with isolated DHCP,
# then restarts the monitoring agent. Runs at boot and on a timer. No SSH, no hand-edited YAML.
#
# This file is sourceable: sourcing it defines the functions without running main,
# so tests/unit.sh can exercise the pure helpers directly.
#
# See docs/dynavlan-PRD.md (behavior), dev/features/dynavlan.md (design).

set -o pipefail

ver="0.4.8"

# Build provenance (FR-38). Semver alone cannot identify what is on a box: every
# build of an unreleased version self-reports the same string, so "which code is
# actually running" becomes unanswerable exactly when it matters. install.sh
# rewrites this line with the source checkout's commit (plus `-dirty` when the
# tree had uncommitted changes, which is not an edge case: it is how a
# half-finished change reaches a box). "source" means running straight from a
# checkout, unstamped.
build="source"

# --- constants (the ONLY hardcoded paths; everything else is discovered) ---
CONF_FILE="/etc/dynavlan.conf"
NETPLAN_FILE="/etc/netplan/90-dynavlan.yaml"   # FR-13: the one file we own
LOCK_FILE="/run/dynavlan.lock"                 # FR-30: fd-held flock
BACKUP_DIR="/var/backups/dynavlan"             # FR-19: audit/history backups (outside /etc/netplan)
MIN_NETPLAN="0.106"                            # FR-0: pinned minimum (Ubuntu 22.04 baseline)
TRY_TIMEOUT=30                                 # FR-18: netplan try confirmation window (starts AFTER its apply)
POLL_INTERVAL=2                                # accept-loop sampling interval (§9)
APPLY_FALLBACK_SETTLE=10                       # min settle before health sampling once probe-iface evidence exists
APPLY_NOEVIDENCE_SETTLE=16                     # C2: larger floor for no-addition changes (removal-only/--reapply) that
                                               # have NO in-kernel apply signal - sized to exceed a real apply so the
                                               # first health sample lands post-apply, must stay <= TRY_TIMEOUT-2*POLL
                                               # - HEALTH_CONSEC*POLL so a no-addition change can still accept (tests §1y)
HEALTH_CONSEC=2                                # consecutive health PASSes required to accept
REAPPLY_LOCK_WAIT=300                          # FR-39: --reapply waits for an in-flight run (a rescan can legitimately take minutes)

# Default log level so log() works before load_config; overwritten by config.
LOG_LEVEL="${LOG_LEVEL:-info}"

# Mutable globals set during a run.
IGNORE_SET=""        # parsed VLAN_IGNORE set
DETECTED_TRUNKS=""   # carrier-up ifaces with >= 1 detected tag (the trunk map)
LAST_BACKUP=""       # path of the most recent pre-change backup
VALIDATE_ERRSRC=""   # "ours" | "base" after a failed backend_validate
VALIDATE_ERRMSG=""
ROUTE_METRICS=""     # "id:metric" map for this run (FR-37, VLAN_ROUTES=true only)

# ---------------------------------------------------------------------------
# Pure helpers (side-effect-free, unit-tested in tests/unit.sh)
# ---------------------------------------------------------------------------

# emit_set IDS...
#   Print the given ids as a sorted, de-duplicated, space-separated set (no trailing
#   space). Empty input prints nothing. Shared by the set-producing helpers below.
emit_set() {
	[ -z "$*" ] && return 0
	printf '%s\n' "$@" | sort -n -u | tr '\n' ' ' | sed 's/ $//'
}

# Network address for an IPv4 ADDR under PREFIX (0-32), as a dotted quad. Pure.
# Subnet tokens key on this, not the host address, so a same-pool DHCP renewal
# maps to an identical token and does not trigger a restart (FR-40).
ipv4_network() { # ADDR PREFIX -> network dotted-quad
	local addr="$1" prefix="$2"
	local o1 o2 o3 o4 ip mask net
	IFS=. read -r o1 o2 o3 o4 <<<"$addr"
	ip=$(( (o1 << 24) | (o2 << 16) | (o3 << 8) | o4 ))
	if [ "$prefix" -le 0 ]; then
		mask=0
	elif [ "$prefix" -ge 32 ]; then
		mask=4294967295
	else
		mask=$(( (4294967295 << (32 - prefix)) & 4294967295 ))
	fi
	net=$(( ip & mask ))
	printf '%d.%d.%d.%d\n' \
		$(( (net >> 24) & 255 )) \
		$(( (net >> 16) & 255 )) \
		$(( (net >> 8) & 255 )) \
		$(( net & 255 ))
}

# parse_vlan_ignore RAW
#   Expand a VLAN_IGNORE string (comma and/or whitespace separated, with inclusive
#   low-high ranges) into a sorted, de-duplicated, space-separated set on stdout.
#   Empty input yields the empty set. Any malformed token, out-of-range id
#   (valid 1-4094; 0 and 4095 are reserved), or inverted range returns non-zero
#   and prints nothing (refuse-to-run at the call site).
parse_vlan_ignore() {
	local raw="$1"
	local -a fields parts
	local f p lo hi i out=""
	read -ra fields <<<"$raw"
	for f in "${fields[@]}"; do
		IFS=',' read -ra parts <<<"$f"
		for p in "${parts[@]}"; do
			if [[ "$p" == *-* ]]; then
				lo="${p%%-*}"
				hi="${p#*-}"
				[[ "$lo" =~ ^[0-9]+$ && "$hi" =~ ^[0-9]+$ ]] || return 1
				((lo <= hi)) || return 1
				((lo >= 1 && hi <= 4094)) || return 1
				for ((i = lo; i <= hi; i++)); do out="$out $i"; done
			else
				[[ "$p" =~ ^[0-9]+$ ]] || return 1
				((p >= 1 && p <= 4094)) || return 1
				out="$out $p"
			fi
		done
	done
	emit_set $out
	return 0
}

# boot_removals OWNED PASS1 PASS2
#   FR-23 two-pass boot removal set: an owned VLAN is removed only if absent from BOTH
#   detection passes. Zero-detection guard (FR-22): if both passes are empty, remove
#   nothing (never read "detected nothing" as "remove everything"). Prints the sorted set.
boot_removals() {
	local owned="$1" p1="$2" p2="$3"
	local -a union=($p1 $p2)
	[ ${#union[@]} -eq 0 ] && return 0
	local seen=" $p1 $p2 " id out=""
	for id in $owned; do
		case "$seen" in *" $id "*) continue ;; esac
		out="$out $id"
	done
	emit_set $out
	return 0
}

# carrier_removals OWNED_ON_TRUNK C1 C2
#   Full removal set for a dead trunk: return the entire owned-on-trunk set when
#   BOTH carrier samples are "down" (a debounced, sustained loss), else empty. A
#   carrier-down port cannot pass frames, so every VLAN on it is dead; this is a
#   full teardown of the trunk's owned set, not a detection diff. Single up sample
#   (a flap across the settle) preserves. Emits a sorted bare-id set.
carrier_removals() { # OWNED_ON_TRUNK C1 C2
	[ "$2" = down ] && [ "$3" = down ] && emit_set $1
	return 0
}

# health_check_eval SNAP_IFACE POST_ROUTES
#   Evaluate the FR-18 default-route health check. SNAP_IFACE is the egress iface of
#   the lowest-metric default route captured before apply ("" if none). POST_ROUTES is
#   the post-apply default routes as "iface:metric" tokens ("" if none). Prints PASS/FAIL.
#   Decision is on the interface only (design §8): a metric or gateway change on the same
#   iface is a normal DHCP event and must not revert. Empty snapshot never reverts on an
#   independently-missing uplink, and generated VLANs add no default (AC-12), so any new
#   default that appears is the base uplink, not ours.
health_check_eval() {
	local snap_iface="$1" post_routes="$2"
	local tok iface metric lowest="" minmetric=""
	for tok in $post_routes; do
		iface="${tok%%:*}"
		metric="${tok#*:}"
		if [ -z "$minmetric" ] || ((metric < minmetric)); then
			minmetric="$metric"
			lowest="$iface"
		fi
	done
	if [ -z "$snap_iface" ]; then
		echo PASS
	elif [ -z "$lowest" ]; then
		echo FAIL
	elif [ "$lowest" = "$snap_iface" ]; then
		echo PASS
	else
		echo FAIL
	fi
	return 0
}

# vlan_guard N WARN LIMIT
#   FR-36 count gate. N = would-be total VLAN set size. Prints OVER when N exceeds
#   LIMIT (LIMIT 0 = unlimited, never OVER), else WARN when N exceeds WARN, else OK.
#   OVER outranks WARN so a limit set below the warn threshold still fires.
vlan_guard() {
	local n="$1" warn="$2" limit="$3"
	if [ "$limit" -gt 0 ] && [ "$n" -gt "$limit" ]; then
		echo OVER
	elif [ "$n" -gt "$warn" ]; then
		echo WARN
	else
		echo OK
	fi
	return 0
}

# limit_fill ADDITIONS SLOTS
#   FR-36 fill mode subset: the SLOTS lowest-NUMERIC-id tokens from ADDITIONS
#   (deterministic: lowest VLAN id first, interface name as tie-break, so every box
#   picks the same subset). SLOTS <= 0 yields the empty set. Selecting by numeric id
#   (not lexical token order) matches the documented "lowest IDs" contract (M7).
limit_fill() {
	local adds="$1" slots="$2" tok out="" n=0
	[ "$slots" -le 0 ] && return 0
	for tok in $(sort_tokens_by_id $adds); do
		out="$out $tok"
		n=$((n + 1))
		[ "$n" -ge "$slots" ] && break
	done
	sort_tokens_by_id $out
	return 0
}

# assign_route_metrics KEPT_MAP ADDITIONS START
#   FR-37 route-metric assignment for VLAN_ROUTES=true. KEPT_MAP is "tok:metric"
#   tokens (surviving assignments read back from our own YAML); ADDITIONS is a set
#   of new iface.id tokens. Prints the full "tok:metric" map sorted by token.
#   Kept assignments are preserved VERBATIM (an existing VLAN's metric never
#   changes); additions, ascending, take max(START-1, highest kept)+1 onward,
#   so new discoveries never renumber the established order.
assign_route_metrics() {
	local kept="$1" adds="$2" start="$3"
	local tok id metric next out=""
	next=$((start - 1))
	for tok in $kept; do
		metric="${tok#*:}"
		[ "$metric" -gt "$next" ] && next="$metric"
	done
	out="$kept"
	for id in $(emit_tokens $adds); do
		next=$((next + 1))
		out="$out ${id}:${next}"
	done
	[ -z "${out// /}" ] && return 0
	printf '%s\n' $out | sort -t: -k1,1 | tr '\n' ' ' | sed 's/ $//'
	return 0
}

# config_body_differs GENERATED LIVE
#   FR-39: DIFFERENT if the two configs differ anywhere below line 1, else SAME.
#
#   Line 1 is the `# Managed by dynavlan <ver> (build <id>)` header. FR-38 put the
#   build id in it, so comparing whole files would report a difference after every
#   rebuild and make --reapply apply unconditionally - a no-change apply, on the
#   one operation that can strand a headless box. Skipping it is also the correct
#   semantics: the header records which build last wrote this body, and if a newer
#   build produces an identical body then the old header is still true.
#
#   The skip is POSITIONAL (exactly line 1), deliberately not a pattern match on
#   header text: a pattern match would silently stop matching if the header format
#   ever changed, and the resulting failure is an apply loop rather than an error.
#
#   Known limit: command substitution strips trailing newlines, so two bodies that
#   differ ONLY in trailing blank lines compare SAME. Harmless as used - both sides
#   come from backend_generate_config, which never emits them - but do not reuse
#   this to compare against a file written by anything else without revisiting it.
config_body_differs() {
	local a b
	a=$(printf '%s\n' "$1" | tail -n +2)
	b=$(printf '%s\n' "$2" | tail -n +2)
	if [ "$a" = "$b" ]; then printf 'SAME'; else printf 'DIFFERENT'; fi
	return 0
}

# map_ids MAP
#   Keys of a "tok:metric" map, as a sorted token set.
map_ids() {
	local map="$1" tok out=""
	for tok in $map; do out="$out ${tok%%:*}"; done
	emit_tokens $out
	return 0
}

# plan_route_metrics OWNED_MAP TARGET ADDITIONS START
#   The single decision point for FR-37 metric assignment: given the map persisted
#   in our own YAML, produce the full "id:metric" map for TARGET.
#
#   The set needing a NEW metric is "target ids that do not already have one", NOT
#   the additions. Those differ whenever an owned VLAN has no persisted metric,
#   which is exactly what an isolated -> routed migration looks like: the operator
#   sets VLAN_ROUTES=true on a box that already owns VLANs, so every owned id
#   lacks a metric while additions is empty or covers only a new VLAN. Assigning
#   for additions alone left the rest unassigned, and backend_generate_config
#   refuses to generate an unassigned id - permanently, on every subsequent run,
#   which also blocked adding any new VLAN while VLAN_ROUTES stayed true. Routed
#   mode therefore only ever worked greenfield (found 2026-07-25).
#
#   Kept ids keep their persisted metric verbatim, so this is idempotent: calling it
#   with no churn returns the same map and never renumbers a live VLAN's priority.
#   Every caller MUST use this rather than composing the pieces itself - a second
#   call site reimplementing the sequence is how the two silently diverge.
plan_route_metrics() {
	local owned="$1" target="$2" adds="$3" start="$4"
	local kept needs
	kept=$(map_filter "$owned" "$(set_minus "$target" "$adds")")
	needs=$(set_minus "$target" "$(map_ids "$kept")")
	assign_route_metrics "$kept" "$needs" "$start"
	return 0
}

# map_filter MAP IDS
#   Keep only the "id:metric" tokens of MAP whose id is in the IDS set (used to
#   drop removed VLANs' persisted metrics before reassignment). Order preserved.
map_filter() {
	local map="$1" ids=" $2 " tok out=""
	for tok in $map; do
		case "$ids" in *" ${tok%%:*} "*) out="${out:+$out }$tok" ;; esac
	done
	printf '%s' "$out"
	return 0
}

# metric_conflict UPLINK_METRIC MAP
#   FR-37 guard: CONFLICT if any assigned metric is <= the uplink default's metric
#   (that VLAN's default would out-prioritize or tie the uplink -> guaranteed
#   health-FAIL revert loop; refuse loudly up front instead). Empty uplink metric
#   (no pre-apply default) -> OK.
metric_conflict() {
	local up="$1" map="$2" tok metric
	if [ -n "$up" ]; then
		for tok in $map; do
			metric="${tok#*:}"
			if [ "$metric" -le "$up" ]; then
				echo CONFLICT
				return 0
			fi
		done
	fi
	echo OK
	return 0
}

# compute_candidates DETECTED MIN MAX IGNORE MANAGED OWNED
#   candidates = detected ∩ [MIN,MAX] − IGNORE − MANAGED − OWNED. Each set arg is a
#   space-separated id list; result is the sorted, de-duplicated set on stdout.
compute_candidates() {
	local detected="$1" min="$2" max="$3" ignore="$4" managed="$5" owned="$6"
	local id out=""
	local excl=" $ignore $managed $owned "
	for id in $detected; do
		((id >= min && id <= max)) || continue
		case "$excl" in *" $id "*) continue ;; esac
		out="$out $id"
	done
	emit_set $out
	return 0
}

# ---------------------------------------------------------------------------
# iface.id token helpers (all-trunks canonical key, spec section 3)
#
# Every set in the pipeline holds iface.id tokens, not bare VLAN ids. These
# convert between the two representations. The split is on the LAST dot, which
# is always the VLAN separator in netplan's <iface>.<id> naming.
# ---------------------------------------------------------------------------

emit_tokens() {
	[ -z "$*" ] && return 0
	printf '%s\n' "$@" | sort -u | tr '\n' ' ' | sed 's/ $//'
}

tok_iface() { printf '%s' "${1%.*}"; }
tok_id()    { printf '%s' "${1##*.}"; }

sort_tokens_by_id() { # TOKENS -> deduped, ordered by numeric VLAN id then interface (FR-36)
	# `.` cannot appear in an interface name (refused at discovery), so each token
	# has exactly one `.`: field 1 = iface, field 2 = id. Key on id numeric, then iface.
	[ -z "$*" ] && return 0
	printf '%s\n' "$@" | sort -u -t. -k2,2n -k1,1 | tr '\n' ' ' | sed 's/ $//'
}

tag_tokens() {
	local iface="$1" ids="$2" id out="" dropped=""
	for id in $ids; do
		# H6: an interface name over IFNAMSIZ (15) is illegal; the kernel would
		# reject the apply. Drop it here (the sole iface.id constructor), so boot,
		# rescan, dry-run preview and the count gate all agree on a legal set.
		if [ "$((${#iface} + 1 + ${#id}))" -gt 15 ]; then
			dropped="$dropped ${iface}.${id}"
			continue
		fi
		out="$out ${iface}.${id}"
	done
	[ -n "$dropped" ] && log warning "interface name exceeds the 15-char kernel limit (IFNAMSIZ); not provisioning:${dropped} - rename the parent NIC shorter, or see the documented limitation"
	emit_tokens $out
}

untag_tokens() {
	local toks="$1" tok out=""
	for tok in $toks; do out="$out ${tok##*.}"; done
	emit_set $out
}

tokens_for_iface() {
	local toks="$1" iface="$2" tok out=""
	for tok in $toks; do
		[ "${tok%.*}" = "$iface" ] && out="$out $tok"
	done
	emit_tokens $out
}

drop_iface_tokens() { # TOKENS "IFACE..." -> TOKENS minus every token on a listed iface
	local toks="$1" ifaces="$2" tok out=""
	[ -z "$ifaces" ] && {
		emit_tokens $toks
		return 0
	}
	for tok in $toks; do
		case " $ifaces " in
		*" ${tok%.*} "*) continue ;;
		esac
		out="$out $tok"
	done
	emit_tokens $out
}

distinct_ifaces() {
	local toks="$1" tok out=""
	for tok in $toks; do out="$out ${tok%.*}"; done
	[ -z "$out" ] && return 0
	printf '%s\n' $out | sort -u | tr '\n' ' ' | sed 's/ $//'
}

# M4: the subset of interfaces bearing an addition that have no carrier right now.
# Additions are computed from the pass-1 detection sample; a trunk that died in the
# detection->apply window would otherwise get new stanzas on a dead parent (they
# never lease, stall wait_leases, fire a pointless restart). A single sample is
# right here: declining an addition is fail-toward-no-change (re-added next rescan),
# unlike a removal, which is destructive and stays debounced.
ifaces_without_carrier() { # ADDITION_TOKENS -> ifaces (subset) lacking carrier
	local iface out=""
	for iface in $(distinct_ifaces "$1"); do
		has_carrier "$iface" || out="$out $iface"
	done
	printf '%s' "${out# }"
}

# ---------------------------------------------------------------------------
# Small set utilities (space-separated sorted id lists)
# ---------------------------------------------------------------------------

set_minus() { # A B -> A without B's members
	local a="$1" b=" $2 " id out=""
	for id in $a; do
		case "$b" in *" $id "*) continue ;; esac
		out="$out $id"
	done
	emit_tokens $out
}

set_union() { emit_tokens $1 $2; }

count_ids() { set -- $1; echo "$#"; }

in_list() { # VALUE "a b c" -> 0 if VALUE is one of the words
	local x="$1" e
	for e in $2; do [ "$x" = "$e" ] && return 0; done
	return 1
}

is_uint() { case "$1" in '' | *[!0-9]*) return 1 ;; *) return 0 ;; esac; }

# ---------------------------------------------------------------------------
# Logging (FR-31/32/33): leveled, to stderr (systemd journal, identifier dynavlan)
# ---------------------------------------------------------------------------

level_num() {
	case "$1" in
	debug) echo 0 ;; info) echo 1 ;; notice) echo 2 ;; warning) echo 3 ;; err) echo 4 ;; *) echo 1 ;;
	esac
}

log() {
	local lvl="$1"
	shift
	[ "$(level_num "$lvl")" -ge "$(level_num "${LOG_LEVEL:-info}")" ] &&
		printf 'dynavlan[%s]: %s\n' "$lvl" "$*" >&2
	return 0
}

usage() {
	printf 'usage: dynavlan --boot|--rescan|--reapply|--dry-run|--status|--reconfigure|--version (-V)\n' >&2
}

# Pure: the full build identity, e.g. "0.1.0 (build 18a6ea2-dirty)". An empty
# build renders "unknown" rather than "(build )", so a failed install-time stamp
# reads as missing provenance instead of passing for a real identity.
version_string() { # VER BUILD -> identity string
	printf '%s (build %s)' "$1" "${2:-unknown}"
}

# ---------------------------------------------------------------------------
# Config (FR-0/6/9) - parse /etc/dynavlan.conf, apply defaults, validate strictly
# ---------------------------------------------------------------------------

# H2: the config is parsed declaratively, never sourced. CONFIG_KEYS is the exact
# documented surface (every key defaulted in load_config below); a config line
# assigning anything else - an internal/safety var (NETPLAN_FILE, TRY_TIMEOUT, ver,
# PATH, ...) or a typo - is refused, and values can never execute code. Keep this
# list in lockstep with the defaults block (Change Checklist: adding a config key).
CONFIG_KEYS="DETECT_METHOD VLAN_MIN VLAN_MAX VLAN_IGNORE VLAN_WARN VLAN_LIMIT \
VLAN_LIMIT_MODE SNIFF_SECONDS BOOT_SETTLE_SECONDS CARRIER_WAIT_SECONDS \
LEASE_SETTLE_SECONDS RESCAN_MINUTES RESET_ON_BOOT REMOVE_ON_CARRIER_LOSS \
VLAN_ROUTES VLAN_ROUTE_METRIC_START RESTART_SNAPS RESTART_SERVICES LOG_LEVEL \
BACKUP_KEEP RESTART_ON_NEW_SUBNET"

config_allowed_key() { # KEY -> 0 if it is a documented config key
	in_list "$1" "$CONFIG_KEYS"
}

config_normalize_value() { # RAWVALUE -> value with inline comment, surrounding quotes, outer whitespace removed
	local v="$1"
	v="${v#"${v%%[![:space:]]*}"}" # trim leading whitespace
	case "$v" in
	'"'*) v="${v#\"}" && v="${v%%\"*}" ;; # double-quoted: inner text (comment after close-quote dropped)
	"'"*) v="${v#\'}" && v="${v%%\'*}" ;; # single-quoted
	*)
		# bare: drop a whitespace-preceded inline comment, then trailing whitespace,
		# KEEPING internal spaces (an unquoted `a b c` list is preserved whole, not
		# silently truncated to `a`; the value validators still reject a bad token).
		v="${v%%[[:space:]]#*}"
		v="${v%"${v##*[![:space:]]}"}"
		;;
	esac
	printf '%s\n' "$v"
}

# Replaces `source`: honor only allowlisted KEY=value lines, refuse anything else.
# Values are assigned as inert literals (printf -v after the key is allowlisted),
# so a config file can neither run code nor set an internal/safety variable.
config_load_file() { # FILE -> 0 on a clean parse, 1 (refuse) on a bad key or non-assignment content
	local file="$1" line key stripped
	while IFS= read -r line || [ -n "$line" ]; do
		stripped="${line#"${line%%[![:space:]]*}"}" # leading-ws-stripped copy
		case "$stripped" in
		'' | '#'*) continue ;; # blank or full-line comment
		esac
		case "$stripped" in
		*=*) ;; # looks like an assignment
		*)
			log err "refusing $file: non-assignment line: $stripped"
			return 1
			;;
		esac
		key="${stripped%%=*}"
		key="${key%"${key##*[![:space:]]}"}" # trim trailing ws on the key
		if ! config_allowed_key "$key"; then
			log err "refusing $file: unknown or protected setting '$key' (not a documented config key)"
			return 1
		fi
		printf -v "$key" '%s' "$(config_normalize_value "${stripped#*=}")"
	done <"$file"
	return 0
}

load_config() {
	DETECT_METHOD="both"
	VLAN_MIN=1
	VLAN_MAX=1000
	VLAN_IGNORE=""
	VLAN_WARN=32
	VLAN_LIMIT=64
	VLAN_LIMIT_MODE=refuse
	SNIFF_SECONDS=60
	BOOT_SETTLE_SECONDS=20
	CARRIER_WAIT_SECONDS=30
	LEASE_SETTLE_SECONDS=30
	RESCAN_MINUTES=5
	RESET_ON_BOOT=true
	REMOVE_ON_CARRIER_LOSS=true
	VLAN_ROUTES=false
	VLAN_ROUTE_METRIC_START=100
	RESTART_SNAPS=""
	RESTART_SERVICES=""
	LOG_LEVEL=info
	BACKUP_KEEP=10
	RESTART_ON_NEW_SUBNET=true

	if [ -f "$CONF_FILE" ]; then
		# Read as root on every run: refuse if the file is not root-owned or is
		# group/other-writable, else a permission drift lets a non-root user feed
		# dynavlan config values it acts on as root. (Enforced only when root.)
		if [ "$(id -u)" -eq 0 ]; then
			local owner mode
			owner=$(stat -c '%u' "$CONF_FILE" 2>/dev/null || stat -f '%u' "$CONF_FILE" 2>/dev/null)
			mode=$(stat -c '%a' "$CONF_FILE" 2>/dev/null || stat -f '%Lp' "$CONF_FILE" 2>/dev/null)
			if [ -z "$owner" ] || [ "$owner" != "0" ] || [ $((0$mode & 022)) -ne 0 ]; then
				log err "refusing to read $CONF_FILE: must be root-owned and not group/other-writable (owner uid=${owner:-unknown} mode=${mode:-unknown})"
				return 1
			fi
		fi
		# H2: parse declaratively (never source) so a config line cannot execute code
		# or assign an internal/safety variable; only allowlisted KEY=value lines are
		# honored, anything else refuses (fail toward no-change, reachable, logged).
		config_load_file "$CONF_FILE" || return 1
	fi

	local k val
	in_list "$LOG_LEVEL" "debug info notice warning err" || {
		log err "invalid LOG_LEVEL=$LOG_LEVEL"
		return 1
	}
	in_list "$DETECT_METHOD" "both lldp sniff" || {
		log err "invalid DETECT_METHOD=$DETECT_METHOD (both|lldp|sniff)"
		return 1
	}
	{ is_uint "$VLAN_MIN" && [ "$VLAN_MIN" -ge 1 ] && [ "$VLAN_MIN" -le 4094 ]; } || {
		log err "invalid VLAN_MIN=$VLAN_MIN (1-4094)"
		return 1
	}
	{ is_uint "$VLAN_MAX" && [ "$VLAN_MAX" -ge 1 ] && [ "$VLAN_MAX" -le 4094 ]; } || {
		log err "invalid VLAN_MAX=$VLAN_MAX (1-4094)"
		return 1
	}
	[ "$VLAN_MIN" -le "$VLAN_MAX" ] || {
		log err "VLAN_MIN($VLAN_MIN) > VLAN_MAX($VLAN_MAX)"
		return 1
	}
	IGNORE_SET=$(parse_vlan_ignore "$VLAN_IGNORE") || {
		log err "invalid VLAN_IGNORE=\"$VLAN_IGNORE\""
		return 1
	}
	{ is_uint "$VLAN_WARN" && [ "$VLAN_WARN" -ge 1 ]; } || {
		log err "invalid VLAN_WARN=$VLAN_WARN (integer >= 1)"
		return 1
	}
	is_uint "$VLAN_LIMIT" || {
		log err "invalid VLAN_LIMIT=$VLAN_LIMIT (integer; 0 = unlimited)"
		return 1
	}
	in_list "$VLAN_LIMIT_MODE" "refuse fill" || {
		log err "invalid VLAN_LIMIT_MODE=$VLAN_LIMIT_MODE (refuse|fill)"
		return 1
	}
	# SNIFF_SECONDS needs a >=1 floor: `timeout 0` means NO timeout, so 0 would make
	# tcpdump run unbounded and detection hang forever.
	{ is_uint "$SNIFF_SECONDS" && [ "$SNIFF_SECONDS" -ge 1 ]; } || {
		log err "invalid SNIFF_SECONDS=$SNIFF_SECONDS (integer >= 1)"
		return 1
	}
	for k in BOOT_SETTLE_SECONDS CARRIER_WAIT_SECONDS LEASE_SETTLE_SECONDS; do
		eval "val=\$$k"
		is_uint "$val" || {
			log err "invalid $k=$val (non-negative integer)"
			return 1
		}
	done
	{ is_uint "$RESCAN_MINUTES" && [ "$RESCAN_MINUTES" -ge 1 ]; } || {
		log err "invalid RESCAN_MINUTES=$RESCAN_MINUTES"
		return 1
	}
	in_list "$RESET_ON_BOOT" "true false" || {
		log err "invalid RESET_ON_BOOT=$RESET_ON_BOOT"
		return 1
	}
	in_list "$REMOVE_ON_CARRIER_LOSS" "true false" || {
		log err "invalid REMOVE_ON_CARRIER_LOSS=$REMOVE_ON_CARRIER_LOSS"
		return 1
	}

	# The FR-41 debounce reuses BOOT_SETTLE_SECONDS as the gap between its two
	# carrier samples. At 0 they are taken back-to-back, so a cable reseat or a port
	# bounce is indistinguishable from a sustained loss and prunes the trunk's whole
	# owned set. Clamp rather than reject: dynavlan.conf is a dpkg conffile, so a box
	# already deployed with 0 would otherwise fail load_config after an upgrade and
	# stop reconciling silently. Only when the destructive path is armed - with the
	# knob off, 0 merely weakens a sniff comparison, exactly as before v0.4.0.
	CARRIER_DEBOUNCE_SECONDS="$BOOT_SETTLE_SECONDS"
	if [ "$REMOVE_ON_CARRIER_LOSS" = true ] && [ "$BOOT_SETTLE_SECONDS" -lt 5 ]; then
		CARRIER_DEBOUNCE_SECONDS=5
		log warning "BOOT_SETTLE_SECONDS=$BOOT_SETTLE_SECONDS is too short to debounce a carrier flap; using ${CARRIER_DEBOUNCE_SECONDS}s for the FR-41 carrier samples (set REMOVE_ON_CARRIER_LOSS=false to opt out of carrier-down removal)"
	fi
	in_list "$VLAN_ROUTES" "true false" || {
		log err "invalid VLAN_ROUTES=$VLAN_ROUTES"
		return 1
	}
	{ is_uint "$VLAN_ROUTE_METRIC_START" && [ "$VLAN_ROUTE_METRIC_START" -ge 1 ]; } || {
		log err "invalid VLAN_ROUTE_METRIC_START=$VLAN_ROUTE_METRIC_START (integer >= 1)"
		return 1
	}
	# >= 1: with 0, prune could delete the just-taken backup pre-revert and leave
	# restore_prior with no disk-convergence target.
	{ is_uint "$BACKUP_KEEP" && [ "$BACKUP_KEEP" -ge 1 ]; } || {
		log err "invalid BACKUP_KEEP=$BACKUP_KEEP (integer >= 1)"
		return 1
	}
	in_list "$RESTART_ON_NEW_SUBNET" "true false" || {
		log err "invalid RESTART_ON_NEW_SUBNET=$RESTART_ON_NEW_SUBNET"
		return 1
	}
	return 0
}

# ---------------------------------------------------------------------------
# Preconditions (FR-0): refuse to run (change nothing) if any fail
# ---------------------------------------------------------------------------

# First N.N[.N] in a version string; empty (exit 0) when there is none.
parse_version() { printf '%s\n' "$1" | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1 || true; }

# `netplan --version` only exists on netplan >= 1.0; the Ubuntu 22.04 fleet ships
# 0.10x, where the flag is unrecognized and only the package manager knows the
# version. Sources are tried in order, first hit wins. stderr is never parsed:
# the 0.10x usage dump would otherwise be scraped for anything resembling a version.
netplan_version() {
	local v
	v=$(parse_version "$(netplan --version 2>/dev/null)")
	[ -n "$v" ] && { printf '%s\n' "$v"; return 0; }
	v=$(parse_version "$(dpkg-query -W -f='${Version}' netplan.io 2>/dev/null)")
	[ -n "$v" ] && { printf '%s\n' "$v"; return 0; }
	return 1
}

version_ge() { # A B -> 0 if A >= B
	[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]
}

check_preconditions() {
	if [ "$(id -u)" -ne 0 ]; then
		log err "must run as root"
		return 1
	fi
	command -v netplan >/dev/null 2>&1 || {
		log err "netplan not found"
		return 1
	}
	local v
	v=$(netplan_version) || true
	if [ -z "$v" ]; then
		log err "cannot determine netplan version (tried 'netplan --version', dpkg-query netplan.io); refusing"
		return 1
	fi
	if ! version_ge "$v" "$MIN_NETPLAN"; then
		log err "netplan >= $MIN_NETPLAN required (found $v)"
		return 1
	fi
	# Non-mutating capability probe (FR-0): introspection only, never a live apply.
	netplan try --help >/dev/null 2>&1 || {
		log err "'netplan try' unavailable; refusing (no silent fallback to bare 'netplan apply')"
		return 1
	}
	if [ "$DETECT_METHOD" = sniff ] || [ "$DETECT_METHOD" = both ]; then
		command -v tcpdump >/dev/null 2>&1 || {
			log err "DETECT_METHOD=$DETECT_METHOD requires tcpdump (not installed)"
			return 1
		}
		# Inbound-only capture is a correctness requirement, not an optimization
		# (see detect_sniff): without it we detect our own egress and removals can
		# never fire. Refuse rather than silently capture both directions. `-d`
		# compiles the filter and exits without opening the device: non-mutating,
		# and it does not need root.
		tcpdump -Q in -d vlan >/dev/null 2>&1 || {
			log err "tcpdump does not support '-Q in' (inbound-only capture); refusing - without it detection counts our own transmitted frames and VLAN removal can never fire"
			return 1
		}
	fi
	if [ "$DETECT_METHOD" = lldp ] || [ "$DETECT_METHOD" = both ]; then
		command -v lldpctl >/dev/null 2>&1 || {
			log err "DETECT_METHOD=$DETECT_METHOD requires lldpctl (not installed)"
			return 1
		}
	fi
	return 0
}

# ---------------------------------------------------------------------------
# Interface + trunk discovery (FR-1/2/3/4)
# ---------------------------------------------------------------------------

discover_phys_ifaces() { # live physical Ethernet NICs, never hardcoded, never from netplan
	local p name
	for p in /sys/class/net/*; do
		name=$(basename "$p")
		[ "$name" = "lo" ] && continue
		[ -e "$p/device" ] || continue  # real device symlink: excludes VLANs, bridges, bonds, veth
		[ -d "$p/wireless" ] && continue # exclude wireless
		[ -e "$p/phy80211" ] && continue
		[ "$(cat "$p/type" 2>/dev/null)" = "1" ] || continue # ARPHRD_ETHER
		# Discovered names feed shell variable construction, YAML, and ip commands:
		# constrain to a safe charset rather than trusting the kernel/udev namespace.
		case "$name" in
		*[!A-Za-z0-9_-]*)
			# `.` is refused: it is dynavlan's own <parent>.<id> VLAN separator, so a
			# dotted parent name cannot round-trip in owned-state (M1). `-`/`_` are kept
			# (a dash-renamed trunk is a plausible admin choice) and handled injectively
			# by iface_key. Standard predictable/legacy NIC names contain none of these.
			log warning "skipping interface with unsupported name characters (only letters, digits, '-', '_'): $name"
			continue
			;;
		esac
		printf '%s\n' "$name"
	done
}

iface_key() { # IFACE -> injective, shell-identifier-safe key (M1)
	# Hex-escape every non-alnum byte (`-`->`_2d`, `_`->`_5f`, ...) so distinct
	# names never alias to one key. This feeds eval (tags_var + the boot carrier
	# stashes), so it must neutralize independently of the discovery charset, not
	# lossily collapse punctuation to `_` (which made enp-1/enp_1/enp.1 collide).
	local s="$1" out="" i c hx
	for ((i = 0; i < ${#s}; i++)); do
		c="${s:i:1}"
		case "$c" in
		[A-Za-z0-9]) out="$out$c" ;;
		*)
			printf -v hx '_%02x' "'$c"
			out="$out$hx"
			;;
		esac
	done
	printf '%s' "$out"
}

tags_var() { # IFACE -> per-iface tag-stash variable name (injective; no eval injection surface)
	printf 'TAGS_%s' "$(iface_key "$1")"
}

valid_var() { # IFACE -> per-iface detection-validity stash (H1); parallel to tags_var
	printf 'VALID_%s' "$(iface_key "$1")"
}

iface_valid() { eval "printf '%s' \"\${$(valid_var "$1"):-}\""; }

prep_fail_var() { # IFACE -> per-iface prep-failure flag stash (H1)
	printf 'PREPFAIL_%s' "$(iface_key "$1")"
}

# detection_sample_valid METHOD SNIFF LLDP PREP -> "valid" or "" (H1)
#   A capture method that FAILED at runtime returns an empty/truncated id set that
#   is indistinguishable from a genuinely empty trunk. A partial (failure-truncated)
#   sample must not authorize a detection-diff REMOVAL. This decides, from the
#   per-method run statuses, whether a boot sample is trustworthy for removals;
#   additions still proceed on whatever positive evidence exists. Each status is
#   ok|fail (na when the mode does not run that method). Prep failure invalidates
#   regardless. Under "both" only SNIFF must have succeeded: sniff is the primary,
#   authoritative wire signal and a failed sniff is the actual removal hazard (an
#   LLDP-only partial set would otherwise authorize removing VLANs sniff would have
#   seen); LLDP is a supplement whose failure is non-fatal, so a down lldpd does not
#   block removals on sniff-authoritative trunks.
detection_sample_valid() {
	local method="$1" sniff="$2" lldp="$3" prep="$4" v=""
	if [ "$prep" = ok ]; then
		case "$method" in
		sniff) [ "$sniff" = ok ] && v=valid ;;
		lldp) [ "$lldp" = ok ] && v=valid ;;
		both) [ "$sniff" = ok ] && v=valid ;;
		esac
	fi
	printf '%s' "$v"
}

prep_iface() { # IFACE - set admin-up + promisc (no wait; carrier waited separately)
	local i="$1" rc=0
	ip link set "$i" up 2>/dev/null || rc=1
	ip link set "$i" promisc on 2>/dev/null || rc=1 # FR-2: makes the NIC VLAN filter transparent; left ON deliberately
	# H1: a prep failure means the sample can be silently truncated (a NIC that
	# never went promisc may drop tagged frames), so record it; run_detection folds
	# it into the removal-trust decision.
	eval "$(prep_fail_var "$i")=\"\$rc\""
}

has_carrier() { [ "$(cat "/sys/class/net/$1/carrier" 2>/dev/null)" = "1" ]; }

detect_sniff() { # IFACE -> "STATUS IDS" - STATUS ok|fail (H1), IDS = distinct 802.1Q VLAN ids
	local i="$1" out rc ids
	# `-Q in` (INBOUND ONLY) is load-bearing, not a tidy-up: tcpdump captures egress
	# too, and every VLAN we own transmits tagged DHCP on the parent (DISCOVER retries
	# forever if it never leases, renewals if it did). Counting our own frames as
	# evidence makes detection self-fulfilling - an owned VLAN is always "detected",
	# so FR-23 removal can never fire, including when the switch genuinely stops
	# trunking it. Only frames the switch actually delivers are evidence of the trunk.
	# Hardware-validated (2026-07-25): the dead enp1s0.100 kept itself alive across
	# reboots this way - 1 outbound VID-100 DHCP Request from our own MAC, 0 inbound.
	#
	# H1: capture tcpdump's own exit BEFORE the grep/awk pipeline so a real
	# open/filter failure is not lost (with pipefail on, grep returning 1 on no-match
	# would otherwise mask it, and an empty capture from a failure would read as a
	# genuinely quiet trunk). `timeout` returns 124 when it kills tcpdump at the end
	# of the window - the NORMAL success case here, since tcpdump runs unbounded; 0 is
	# a clean early exit; anything else is a real failure (device could not be opened,
	# BPF filter rejected, runtime error) and the sample must not authorize removals.
	out=$(timeout "$SNIFF_SECONDS" tcpdump -i "$i" -e -nn -p -Q in -s 64 'vlan' 2>/dev/null)
	rc=$?
	ids=$(printf '%s\n' "$out" | grep -oE 'vlan [0-9]+' | awk '{print $2}' | sort -n -u | tr '\n' ' ' | sed 's/ $//')
	case "$rc" in
	0 | 124) printf 'ok %s' "$ids" ;;
	*) printf 'fail %s' "$ids" ;;
	esac
}

# Pure: tagged VLAN ids from `lldpctl -f keyvalue` text, native VLAN excluded.
# The native VLAN is UNTAGGED on the wire, so a VLAN interface carrying its tag
# can never receive a frame (it comes up, never leases, and stays dead) - LLDP
# must not offer it as a tagged candidate. lldpctl flags it pvid=yes, but emits
# one flat block per VLAN with no index in the key, so vlan-id and its pvid are
# correlated by ADJACENCY only and the parse has to be stateful. A block with no
# pvid key is treated as tagged: absence of the flag is not evidence of native.
#
# The patterns anchor on `.vlan.` - the VLAN TLV's own subtree - NOT on anything
# ending in `.vlan-id=`. lldpd's full key set is not documented here, and matching
# loosely makes this parse depend on assuming what else it emits. Two ways that
# bites, both reproduced in tests (1i): a foreign `.vlan-id=` key landing between
# a VLAN's vlan-id and its pvid flushes that id as "tagged" before the pvid is
# seen, rebuilding the dead native-VLAN interface FR-7a exists to prevent; and the
# foreign key's own VALUE becomes a candidate, so dynavlan would build an
# interface for a VLAN that is not on the trunk at all.
lldp_tagged_vlans() {
	printf '%s\n' "$1" | awk '
		/\.vlan\.vlan-id=/ {
			if (pending != "") print pending
			pending = ""
			v = $0
			sub(/.*\.vlan\.vlan-id=/, "", v)
			if (v ~ /^[0-9]+/) { sub(/[^0-9].*/, "", v); pending = v }
			next
		}
		/\.vlan\.pvid=yes/ { pending = ""; next }
		END { if (pending != "") print pending }
	' | sort -n -u | tr '\n' ' ' | sed 's/ $//'
}

detect_lldp() { # IFACE -> "STATUS IDS" - STATUS ok|fail (H1), IDS = tagged LLDP VLAN ids (PVID excluded)
	local i="$1" out rc
	# lldpctl returns 0 even with no neighbors (empty output); a non-zero exit means
	# the daemon is down or the query errored - a failed sample, not an empty trunk.
	out=$(lldpctl -f keyvalue "$i" 2>/dev/null)
	rc=$?
	case "$rc" in
	0) printf 'ok %s' "$(lldp_tagged_vlans "$out")" ;;
	*) printf 'fail %s' "$(lldp_tagged_vlans "$out")" ;;
	esac
}

# IFACE -> "SNIFFSTATUS LLDPSTATUS IDS..." (H1). Relays each enabled method's run
# status (ok|fail, or na when the mode does not run it) plus the unioned id set;
# run_detection folds these with the prep-failure flag via detection_sample_valid.
detect_iface() {
	local i="$1" ids="" sniff_st=na lldp_st=na out
	case "$DETECT_METHOD" in
	sniff | both)
		out=$(detect_sniff "$i")
		sniff_st=${out%% *}
		case "$out" in *" "*) ids="$ids ${out#* }" ;; esac
		;;
	esac
	case "$DETECT_METHOD" in
	lldp | both)
		out=$(detect_lldp "$i")
		lldp_st=${out%% *}
		case "$out" in *" "*) ids="$ids ${out#* }" ;; esac
		;;
	esac
	printf '%s %s %s' "$sniff_st" "$lldp_st" "$(emit_set $ids)"
}

# IFACE RAW - parse a detect_iface line ("SNIFFSTATUS LLDPSTATUS IDS...") and stash
# the tag set (TAGS_) and the removal-trust verdict (VALID_) for the iface (H1). A
# missing/short line defaults to fail (safe: preserves owned VLANs on the diff path).
store_detection() {
	local i="$1" raw="$2" sniff_st lldp_st tg v pfv prep_st
	IFS=' ' read -r sniff_st lldp_st tg <<<"$raw"
	eval "pfv=\"\${$(prep_fail_var "$i"):-0}\""
	prep_st=ok
	[ "$pfv" = 0 ] || prep_st=fail
	v=$(detection_sample_valid "$DETECT_METHOD" "${sniff_st:-fail}" "${lldp_st:-fail}" "$prep_st")
	if [ "$v" = valid ]; then
		eval "$(valid_var "$i")=valid"
	else
		eval "$(valid_var "$i")=invalid"
	fi
	[ -n "$tg" ] && eval "$(tags_var "$i")=\"\$tg\""
}

iface_tags() { eval "printf '%s' \"\${$(tags_var "$1"):-}\""; }

run_detection() { # sets DETECTED_TRUNKS + per-trunk tags via iface_tags; returns 1 if no trunks
	local ifaces i tags n
	ifaces=$(discover_phys_ifaces)
	for i in $ifaces; do prep_iface "$i"; done
	local elapsed=0 allup up=""
	while [ "$elapsed" -lt "$CARRIER_WAIT_SECONDS" ]; do
		allup=1
		for i in $ifaces; do has_carrier "$i" || allup=0; done
		[ "$allup" = 1 ] && break
		sleep 1
		elapsed=$((elapsed + 1))
	done
	for i in $ifaces; do
		if has_carrier "$i"; then
			up="$up $i"
		else
			log info "no carrier on $i within ${CARRIER_WAIT_SECONDS}s; skipping detection on it"
		fi
	done
	for i in $ifaces; do unset "$(tags_var "$i")" "$(valid_var "$i")" 2>/dev/null; done
	local scratch=""
	[ -n "$up" ] && scratch=$(mktemp -d /run/dynavlan.detect.XXXXXX 2>/dev/null) || scratch=""
	if [ -n "$scratch" ]; then
		for i in $up; do detect_iface "$i" >"$scratch/$i" & done
		wait
		for i in $up; do store_detection "$i" "$(cat "$scratch/$i" 2>/dev/null)"; done
		rm -rf "$scratch"
	else
		for i in $up; do store_detection "$i" "$(detect_iface "$i")"; done
	fi
	DETECTED_TRUNKS=""
	for i in $(printf '%s\n' $up | sort -u); do
		tags=$(iface_tags "$i")
		if [ -n "$tags" ]; then
			n=$(count_ids "$tags")
			DETECTED_TRUNKS="$DETECTED_TRUNKS $i"
			log info "trunk $i: $n tags detected [$(emit_set $tags)]"
		fi
	done
	DETECTED_TRUNKS=$(printf '%s\n' $DETECTED_TRUNKS | sort -u | tr '\n' ' ' | sed 's/^ //' | sed 's/ $//')
	if [ -z "$DETECTED_TRUNKS" ]; then
		return 1
	fi
	return 0
}

# ---------------------------------------------------------------------------
# Backend seam (§4) - netplan implementation, the only backend today.
# The core never touches netplan except through these six backend_* functions.
# ---------------------------------------------------------------------------

backend_owned_vlans() { # iface.id tokens currently in OUR file (the known-set, FR-20)
	[ -f "$NETPLAN_FILE" ] || return 0
	grep -E '^[[:space:]]+[a-zA-Z0-9_-]+\.[0-9]+:$' "$NETPLAN_FILE" 2>/dev/null |
		sed 's/^[[:space:]]*//' | sed 's/:$//' | sort -u | tr '\n' ' ' | sed 's/ $//'
}

backend_owned_metrics() { # "iface.id:metric" map persisted in OUR file (FR-37 state)
	[ -f "$NETPLAN_FILE" ] || return 0
	awk '
		/^[[:space:]]+[a-zA-Z0-9_-]+\.[0-9]+:$/ { name = $1; sub(/:$/, "", name) }
		/^[[:space:]]+route-metric:[[:space:]]*[0-9]+/ { if (name != "") { print name ":" $2; name = "" } }
	' "$NETPLAN_FILE" 2>/dev/null | sort -u | tr '\n' ' ' | sed 's/ $//'
}

backend_list_managed_vlans() { # IFACE - bare VLAN ids managed elsewhere on THIS iface
	local iface="$1" all owned_ids
	all=$({
		# netplan get emits id: before link: (verified on netplan 0.107); collect
		# both per stanza and emit at the next header or EOF.
		netplan get network.vlans 2>/dev/null | awk -v iface="$iface" '
			/^[a-zA-Z0-9_.-]+\.[0-9]+:/ {
				if (vid != "" && lnk == iface) print vid
				vid = ""; lnk = ""
			}
			/^[[:space:]]+id:/ { vid = $2 }
			/^[[:space:]]+link:/ { gsub(/"/, "", $2); lnk = $2 }
			END { if (vid != "" && lnk == iface) print vid }
		'
		ip -d link show type vlan 2>/dev/null | awk -v p="@${iface}:" '
			$0 ~ p { getit = 1; next }
			getit && /id [0-9]/ { for (i=1;i<=NF;i++) if ($i=="id") { print $(i+1); break }; getit = 0 }
		'
	} | sort -n -u | tr '\n' ' ' | sed 's/ $//')
	owned_ids=$(untag_tokens "$(tokens_for_iface "$(backend_owned_vlans)" "$iface")")
	set_minus "$all" "$owned_ids"
}

backend_generate_config() { # TARGET_TOKENS - write our file atomically (FR-13/14/16)
	local tokens="$1" tok iface id tmp
	tmp=$(mktemp "$(dirname "$NETPLAN_FILE")/.dynavlan.XXXXXX") || return 1
	{
		printf '# Managed by dynavlan %s - do not edit; regenerated on each change.\n' "$(version_string "$ver" "$build")"
		printf 'network:\n  version: 2\n'
		if [ -n "$tokens" ]; then
			printf '  vlans:\n'
			for tok in $(emit_tokens $tokens); do
				iface="${tok%.*}"
				id="${tok##*.}"
				printf '    %s:\n' "$tok"
				printf '      id: %s\n' "$id"
				printf '      link: %s\n' "$iface"
				printf '      dhcp4: true\n'
				# RA would hand the VLAN a SLAAC address + default route that bypasses
				# every DHCPv4 decline and is invisible to the FR-18 IPv4 health check.
				printf '      accept-ra: false\n'
				printf '      dhcp4-overrides:\n'
				if [ "$VLAN_ROUTES" = true ]; then
					local metric="" mtok
					for mtok in $ROUTE_METRICS; do
						[ "${mtok%%:*}" = "$tok" ] && metric="${mtok#*:}"
					done
					if [ -z "$metric" ]; then
						log err "internal: no route metric assigned for $tok (map [$ROUTE_METRICS]); refusing to generate"
						rm -f "$tmp"
						return 1
					fi
					printf '        use-routes: true\n'
					printf '        route-metric: %s\n' "$metric"
				else
					printf '        use-routes: false\n'
				fi
				printf '        use-dns: false\n'
				printf '        use-ntp: false\n'
				printf '        use-domains: false\n'
			done
		fi
	} >"$tmp" || {
		rm -f "$tmp"
		return 1
	}
	chmod 600 "$tmp" 2>/dev/null
	sync "$tmp" 2>/dev/null || sync
	mv -f "$tmp" "$NETPLAN_FILE" || {
		rm -f "$tmp"
		return 1
	}
	return 0
}

backend_validate() { # [ROOTDIR] - netplan generate; sets VALIDATE_ERRSRC/MSG on failure (FR-17)
	local rootdir="$1" out rc
	if [ -n "$rootdir" ]; then
		out=$(netplan generate --root-dir "$rootdir" 2>&1)
		rc=$?
	else
		out=$(netplan generate 2>&1)
		rc=$?
	fi
	[ "$rc" -eq 0 ] && return 0
	VALIDATE_ERRMSG="$out"
	if printf '%s' "$out" | grep -q '90-dynavlan.yaml'; then
		VALIDATE_ERRSRC="ours"
	else
		VALIDATE_ERRSRC="base"
	fi
	return 1
}

# FR-18 / §9: apply via netplan try, health-check-gated accept driven through a fifo.
#
# TIMING MODEL (the crux): netplan try APPLIES the config first and only then reads
# stdin for confirmation; its revert timer starts after the apply. A newline written
# into the fifo early would sit in the pipe buffer and be consumed unconditionally
# AFTER the apply - accepting a change the health check never actually saw applied.
# So the accept is gated on three conditions, evaluated in a poll loop:
#   1. APPLY EVIDENCE: PROBE_IFC (an interface that exists only once the apply has
#      run, i.e. the first added VLAN) is present, then a settle floor of
#      APPLY_FALLBACK_SETTLE. Changes with no additions have no such signal, so they
#      fall back to the LARGER APPLY_NOEVIDENCE_SETTLE floor (via apply_settle_floor)
#      - see the C2 note below.
#   2. LIVENESS: netplan try is still running at accept time. A dead try means it
#      reverted or failed - either way, never accept (a false accept would delete
#      interfaces and restart the agent for a change that was never applied).
#   3. HEALTH: post_apply_health PASSes on HEALTH_CONSEC consecutive samples.
# On FAIL: write nothing AND keep the fifo write-end open until netplan try exits,
# so it reverts via its own validated timeout path (stdin EOF behavior on early
# close is NOT hardware-validated; do not exercise it). An independent wall-clock
# guard bounds the whole interaction regardless of netplan try's own timer.
# C2: with a probe iface the apply is observable (the netdev appears); without one
# (removal-only / --reapply) nothing in the kernel changes during the try window, so
# the floor must be conservative enough that the first health sample is post-apply.
apply_settle_floor() { # PROBE_IFC -> seconds to settle before health sampling begins
	if [ -n "$1" ]; then
		printf '%s\n' "$APPLY_FALLBACK_SETTLE"
	else
		printf '%s\n' "$APPLY_NOEVIDENCE_SETTLE"
	fi
}

backend_apply_with_revert() { # SNAP_IFACE PROBE_IFC -> 0 accepted, 1 reverted/failed
	local snap_iface="$1" probe="$2" fifo result trypid try_rc
	local waited=0 consec=0 accepted=0 seen_at=""
	local settle_floor
	settle_floor=$(apply_settle_floor "$probe")
	local wall_guard=$((TRY_TIMEOUT * 3)) # apply phase + confirmation window + margin
	# The accept must land INSIDE netplan try's confirmation window. Its revert timer
	# starts when its apply completes, which is AT OR BEFORE the moment our probe
	# first appears (seen_at). So accepting is forbidden once
	# (waited - seen_at) >= TRY_TIMEOUT - 2*POLL_INTERVAL: beyond that point a
	# still-alive netplan try may be mid-REVERT, routing may have just been restored
	# by the revert itself (health would PASS!), and a buffered newline would land as
	# a false ACCEPT for a change that was rolled back.
	local accept_cutoff=$((TRY_TIMEOUT - 2 * POLL_INTERVAL))
	fifo=$(mktemp -u /run/dynavlan.fifo.XXXXXX)
	mkfifo "$fifo" 2>/dev/null || {
		log err "cannot create fifo $fifo"
		return 1
	}
	trap '' PIPE # accept-write must tolerate netplan try having already exited
	netplan try --timeout "$TRY_TIMEOUT" <"$fifo" >/dev/null 2>&1 &
	trypid=$!
	exec 9>"$fifo" # open write end (unblocks netplan try's read-open)
	while [ "$waited" -lt "$wall_guard" ]; do
		if ! kill -0 "$trypid" 2>/dev/null; then
			log err "netplan try exited before accept (reverted or failed); not accepting"
			break
		fi
		# Apply evidence: the probe iface appearing means the apply has BEGUN (netdev
		# creation is async after the networkd restart; it does not prove completion,
		# which is why the settle floor below is unconditional). Probe checked every
		# tick from t=0 so seen_at tracks the earliest evidence. No-probe changes
		# (removal-only) anchor the window at t=0, which is conservative-safe.
		if [ -z "$seen_at" ]; then
			if [ -n "$probe" ]; then
				ip link show "$probe" >/dev/null 2>&1 && seen_at="$waited"
			else
				seen_at=0
			fi
		fi
		# Health sampling starts only after evidence AND a settle floor (probe
		# appearance alone can precede the apply's routing effects by seconds). For
		# no-addition changes the floor is larger (settle_floor via apply_settle_floor):
		# there is no probe to prove apply progress, so the floor alone must guarantee
		# the sample lands post-apply, never on pre-apply routing (C2).
		if [ -n "$seen_at" ] && [ "$waited" -ge "$settle_floor" ]; then
			if [ $((waited - seen_at)) -ge "$accept_cutoff" ]; then
				log err "confirmation window elapsed without sustained health (revert imminent or in progress); not accepting"
				break
			fi
			result=$(post_apply_health "$snap_iface")
			if [ "$result" = PASS ]; then
				consec=$((consec + 1))
			else
				consec=0
			fi
			if [ "$consec" -ge "$HEALTH_CONSEC" ]; then
				if kill -0 "$trypid" 2>/dev/null; then # liveness re-check at the accept instant
					printf '\n' >&9 2>/dev/null && accepted=1
				fi
				break
			fi
		fi
		sleep "$POLL_INTERVAL"
		waited=$((waited + POLL_INTERVAL))
	done
	[ "$waited" -ge "$wall_guard" ] && log err "wall-clock guard (${wall_guard}s) expired waiting for apply evidence + health; not accepting"
	if [ "$accepted" -eq 1 ]; then
		exec 9>&- # close after the accept write; netplan try exits immediately on accept
		# C2 backstop: netplan try exits 0 on an accepted keep. A non-zero exit here
		# means the apply we just committed reported failure - record it (FR-38 audit);
		# it does not un-accept (the newline is already sent) but it must not be silent.
		wait "$trypid" 2>/dev/null
		try_rc=$?
		[ "$try_rc" -ne 0 ] && log err "netplan try reported non-zero exit ($try_rc) after ACCEPT; applied state should be verified"
	else
		# FAIL path: hold the write end OPEN so netplan try sees no EOF and reverts on
		# its own timer (the hardware-validated path), bounded by an independent clock.
		waited=0
		while kill -0 "$trypid" 2>/dev/null && [ "$waited" -lt "$wall_guard" ]; do
			sleep "$POLL_INTERVAL"
			waited=$((waited + POLL_INTERVAL))
		done
		exec 9>&-
		if kill -0 "$trypid" 2>/dev/null; then
			log err "netplan try still running after ${wall_guard}s post-decision; leaving it to its own revert; state uncertain"
		else
			wait "$trypid" 2>/dev/null
			try_rc=$?
			log info "netplan try exited $try_rc after revert/no-accept (expected non-zero on a timed revert)"
		fi
	fi
	trap - PIPE
	rm -f "$fifo"
	[ "$accepted" -eq 1 ]
}

backend_remove_vlan() { # TOKEN (iface.id) - tear down live interface (FR-24)
	local tok="$1" ifc="$1"
	if ip link show "$ifc" >/dev/null 2>&1; then
		if ip link delete "$ifc" 2>/dev/null; then
			log notice "removed VLAN $(tok_id "$tok") (deleted interface $ifc)"
		else
			# M5: rc 1 tells the caller to record this for a retry next run; the
			# stanza is already gone from our file, so a forgotten failure would
			# strand the live interface (and its subnet) until reboot.
			log warning "failed to delete interface $ifc"
			return 1
		fi
	else
		log info "VLAN $(tok_id "$tok") interface $ifc already absent"
	fi
}

# M5: interfaces whose post-ACCEPT `ip link delete` failed and must be retried.
# /run is tmpfs, wiped on reboot - the correct lifetime: a VLAN interface never
# survives a reboot, so a pending-delete record must not either. The record is
# ownership-safe: only tokens dynavlan itself removed are ever written here, so a
# drain never touches a genuinely external VLAN (backend_list_managed_vlans still
# excludes those). Runtime scratch, NOT config: config state lives only in the
# owned netplan file.
PENDING_DELETE_FILE="${PENDING_DELETE_FILE:-/run/dynavlan/pending-delete}"

pending_deletes() { # -> sorted-unique iface.id tokens awaiting re-delete
	[ -f "$PENDING_DELETE_FILE" ] || return 0
	emit_tokens $(< "$PENDING_DELETE_FILE")
}

write_pending_deletes() { # TOKENS - replace the record (empty removes the file)
	local toks
	toks=$(emit_tokens $1)
	if [ -z "$toks" ]; then
		rm -f "$PENDING_DELETE_FILE"
		return 0
	fi
	mkdir -p "$(dirname "$PENDING_DELETE_FILE")" 2>/dev/null || return 1
	printf '%s\n' $toks >"$PENDING_DELETE_FILE"
}

record_pending_delete() { # TOKEN - remember a delete that failed, for next run
	write_pending_deletes "$(pending_deletes) $1"
}

drain_pending_deletes() { # retry every recorded delete; keep only those still failing
	[ -f "$PENDING_DELETE_FILE" ] || return 0
	local tok survivors=""
	for tok in $(pending_deletes); do
		backend_remove_vlan "$tok" || survivors="$survivors $tok"
	done
	write_pending_deletes "$survivors"
}

# ---------------------------------------------------------------------------
# Default-route snapshot + health check (FR-18, design §8)
# ---------------------------------------------------------------------------

default_routes_tokens() { # one "iface:metric" per default route (metric absent -> 0)
	ip route show default 2>/dev/null | while read -r line; do
		local dev metric
		dev=$(printf '%s\n' "$line" | grep -oE 'dev [^ ]+' | awk '{print $2}')
		[ -z "$dev" ] && continue
		metric=$(printf '%s\n' "$line" | grep -oE 'metric [0-9]+' | awk '{print $2}')
		[ -z "$metric" ] && metric=0
		printf '%s:%s\n' "$dev" "$metric"
	done
}

snapshot_default_route() { # dev of the lowest-metric default route, "" if none
	local tok dev metric best_dev="" best_metric=""
	for tok in $(default_routes_tokens); do
		dev="${tok%%:*}"
		metric="${tok#*:}"
		if [ -z "$best_metric" ] || [ "$metric" -lt "$best_metric" ]; then
			best_metric="$metric"
			best_dev="$dev"
		fi
	done
	printf '%s' "$best_dev"
}

snapshot_default_metric() { # metric of the lowest-metric default route, "" if none
	local tok metric best=""
	for tok in $(default_routes_tokens); do
		metric="${tok#*:}"
		if [ -z "$best" ] || [ "$metric" -lt "$best" ]; then best="$metric"; fi
	done
	printf '%s' "$best"
}

# C1: is the current default-route iface itself in the removal set? Only reachable in
# routed mode - with isolation the default route is always the base uplink, never a
# dynavlan VLAN token, so snap_iface can never match a removal token. Exact token match,
# so a same-id VLAN on a different trunk (a distinct token) does not false-positive.
default_iface_in_removals() { # SNAP_IFACE REMOVALS -> 0 if snap_iface is non-empty AND in removals
	[ -n "$1" ] && in_list "$1" "$2"
}

# have_routing
#   True iff the box has a usable default route: a lowest-metric default exists,
#   the iface it egresses currently has carrier, AND at least one physical NIC has
#   carrier. Pre-condition for carrier-down removal - if routing is already gone,
#   preserve everything and change nothing.
#
#   The physical-carrier clause is not redundant. A tun/wireguard/tailscale netdev
#   reports carrier=1 whenever it is merely configured up - those drivers do no
#   peer-reachability tracking - so a box whose lowest-metric default egresses a
#   tunnel would otherwise report healthy routing while every physical port is
#   dark. That is exactly the all-dark state AC-4 exists to protect. Testing the
#   egress dev against a physical whitelist instead would be wrong: it would also
#   reject a legitimate default routed over a VLAN netdev, and would disable
#   pruning outright on a box that genuinely routes over a VPN. Requiring one live
#   physical NIC keeps that box working while still catching all-dark.
#
#   Note this is the ONLY gate on the doomed-removal case: the post-apply health
#   check does NOT back it up. When the uplink is already gone the route snapshot
#   is empty, and an empty snapshot is a deliberate unconditional PASS (AC-12,
#   "never revert on an independently-missing uplink"). Do not weaken this on the
#   assumption that the health check would catch what it lets through.
have_routing() {
	local dev p
	dev=$(snapshot_default_route)
	[ -n "$dev" ] || return 1
	has_carrier "$dev" || return 1
	for p in $(discover_phys_ifaces); do
		has_carrier "$p" && return 0
	done
	return 1
}

post_apply_health() { # SNAP_IFACE -> PASS/FAIL (delegates the decision to the pure evaluator)
	local snap_iface="$1" tokens
	tokens=$(default_routes_tokens | tr '\n' ' ')
	health_check_eval "$snap_iface" "$tokens"
}

# ---------------------------------------------------------------------------
# Backups (FR-19)
# ---------------------------------------------------------------------------

backup_current() { # -> non-zero if a prior file exists but could not be backed up
	[ -f "$NETPLAN_FILE" ] || return 0
	mkdir -p -m 700 "$BACKUP_DIR" 2>/dev/null
	local ts
	ts=$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null || echo backup)
	LAST_BACKUP="$BACKUP_DIR/90-dynavlan.yaml.$ts.$$"
	if ! cp -p "$NETPLAN_FILE" "$LAST_BACKUP" 2>/dev/null; then
		LAST_BACKUP=""
		return 1
	fi
	return 0
}

restore_prior() { # HAD_PRIOR - converge disk back to the prior file (or none on first run)
	local had="$1"
	if [ "$had" = 1 ] && [ -n "$LAST_BACKUP" ] && [ -f "$LAST_BACKUP" ]; then
		# Failure here means disk has our new (reverted) config while the live state is
		# the prior one: the next run's owned-set would be wrong. Nothing safe to do at
		# this point but be loud about exactly where the known-good copy still lives.
		if cp -p "$LAST_BACKUP" "$NETPLAN_FILE" 2>/dev/null; then
			chmod 600 "$NETPLAN_FILE" 2>/dev/null
		else
			log err "could not restore prior $NETPLAN_FILE from $LAST_BACKUP (disk full?); on-disk config now DIVERGES from live state - restore it manually from $LAST_BACKUP"
		fi
	else
		rm -f "$NETPLAN_FILE" 2>/dev/null
	fi
}

prune_backups() {
	[ -d "$BACKUP_DIR" ] || return 0
	local keep="${BACKUP_KEEP:-10}"
	ls -1t "$BACKUP_DIR"/90-dynavlan.yaml.* 2>/dev/null | tail -n +"$((keep + 1))" |
		while read -r f; do rm -f "$f"; done
}

# ---------------------------------------------------------------------------
# Change-gated side effects (FR-27/28)
# ---------------------------------------------------------------------------

iface_has_lease() { ip -4 addr show dev "$1" 2>/dev/null | grep -q 'inet '; } # IPv4 addr present

wait_leases() { # TOKENS (iface.id) - bounded, non-fatal wait for new-VLAN leases
	# ONE box-wide deadline, not a per-token wait in series (H5). Every new VLAN
	# is already DHCPing in parallel once the apply accepted, so poll them all each
	# second and stop as soon as none are pending; the total wait is bounded by
	# LEASE_SETTLE_SECONDS regardless of VLAN count. A per-token loop stacked to
	# N x LEASE_SETTLE_SECONDS (up to 64 x 30s = 1920s at the cap), which could
	# exceed the systemd start timeout and get the run killed BEFORE restart_targets
	# ran, silently skipping the FR-27 monitoring-agent restart.
	local tokens="$1" tok waited=0 pending
	[ -z "$tokens" ] && return 0
	while [ "$waited" -lt "$LEASE_SETTLE_SECONDS" ]; do
		pending=""
		for tok in $tokens; do
			iface_has_lease "$tok" || pending="$pending $tok"
		done
		[ -z "$pending" ] && break
		sleep 1
		waited=$((waited + 1))
	done
	for tok in $tokens; do
		if iface_has_lease "$tok"; then
			log info "VLAN $(tok_id "$tok") leased on $tok"
		else
			log warning "VLAN $(tok_id "$tok") ($tok) acquired no lease within ${LEASE_SETTLE_SECONDS}s"
		fi
	done
}

restart_targets() {
	local s
	RESTARTED_THIS_RUN=1
	for s in $RESTART_SNAPS; do
		if snap restart "$s" >/dev/null 2>&1; then
			log notice "restarted snap $s"
		else
			log warning "failed to restart snap $s (missing or error); continuing"
		fi
	done
	for s in $RESTART_SERVICES; do
		if systemctl restart "$s" >/dev/null 2>&1; then
			log notice "restarted service $s"
		else
			log warning "failed to restart service $s (missing or error); continuing"
		fi
	done
}

# FR-40 ephemeral state: subnets the agent is known to have seen THIS uptime.
# /run is tmpfs, wiped on reboot, which is exactly the required lifetime (on
# reboot the agent relaunches and re-enumerates, so the baseline must reset).
# This is runtime scratch, NOT persistent config: config state still lives only
# in the owned netplan file.
SEEN_FILE="${SEEN_FILE:-/run/dynavlan/seen}"

# Current global-scope IPv4 subnets as sorted `iface:network/prefix` tokens.
# `scope global` excludes loopback (127/8, scope host) and IPv4 link-local
# (169.254/16, scope link): a link-local address means DHCP FAILED and must not
# count as a subnet. The token keys on the network, so a same-pool renewal is a
# no-op (see ipv4_network).
current_subnets() {
	local idx ifc fam cidr rest addr prefix net out=""
	while read -r idx ifc fam cidr rest; do
		# Skip non-CIDR field-4 forms: a peer/point-to-point line renders as
		# `inet 10.8.0.1 peer 10.8.0.2/32 scope global`, where the LOCAL address
		# in field 4 carries no /prefix. Without this, `${cidr#*/}` would yield
		# the whole address as the "prefix" and ipv4_network would error on every
		# run (tun/ppp/VPN interfaces on a monitored box hit this).
		case "$cidr" in
			*/*) ;;
			*) continue ;;
		esac
		addr=${cidr%/*}
		prefix=${cidr#*/}
		net=$(ipv4_network "$addr" "$prefix")
		out="$out ${ifc}:${net}/${prefix}"
	done < <(ip -4 -o addr show scope global 2>/dev/null)
	emit_tokens $out
}

read_seen() { # -> seen-set contents, empty if the file is absent
	cat "$SEEN_FILE" 2>/dev/null || true
}

write_seen() { # SET
	mkdir -p "$(dirname "$SEEN_FILE")" 2>/dev/null || true
	printf '%s\n' "$1" >"$SEEN_FILE" 2>/dev/null \
		|| log warning "could not write $SEEN_FILE; next run may restart again"
}

# FR-40 rule, run once at the end of every --boot/--rescan (see main). On the
# first run of an uptime SEEN_FILE is absent, so `seen` is empty and every
# current subnet is "new": the agent is restarted once after the network has
# settled, regardless of whether it started before or after DHCP. A per-run
# RESTARTED_THIS_RUN flag dedups against any VLAN restart apply_change already did.
maybe_restart_on_new_subnet() {
	[ "$RESTART_ON_NEW_SUBNET" = true ] || return 0
	local current seen new
	current=$(current_subnets)
	seen=$(read_seen)
	new=$(set_minus "$current" "$seen")
	if [ -n "$new" ]; then
		if [ "${RESTARTED_THIS_RUN:-0}" = 1 ]; then
			log info "new IPv4 subnet(s) [$new]; agent already restarted this run"
		elif [ -z "$RESTART_SNAPS" ] && [ -z "$RESTART_SERVICES" ]; then
			log info "new IPv4 subnet(s) [$new]; no restart targets configured"
		else
			log notice "new IPv4 subnet(s) [$new]; restarting monitoring targets"
			restart_targets
		fi
	fi
	write_seen "$(set_union "$seen" "$current")"
}

# ---------------------------------------------------------------------------
# Apply/rollback state machine (design §7) - the safety-critical chain
# ---------------------------------------------------------------------------

apply_change() { # TARGET_TOKENS ADDITION_TOKENS REMOVAL_TOKENS [LEASE_TOKENS]
	local target="$1" additions="$2" removals="$3" lease_set="${4-$2}"
	local snap_iface had_prior=0 tok probe=""
	for tok in $additions; do
		probe="$tok"
		break
	done
	snap_iface=$(snapshot_default_route)
	# C1: refuse BEFORE any disk change if the box's current default-route iface is
	# itself being removed. netplan try's health check would PASS (the VLAN is still up
	# during the try; the delete happens only post-ACCEPT), we would ACCEPT, then
	# `ip link delete` would tear down the default egress with no revert - a strand.
	# Preserve the active default VLAN and change nothing; the operator must move the
	# default (or the VLAN must stop being the default) before it can be removed.
	if default_iface_in_removals "$snap_iface" "$removals"; then
		log err "refusing reconcile: the current default-route interface ($snap_iface) is in the removal set [${removals}]; removing it would strand the box's default egress with no revert. Preserving it and changing nothing - provide an alternate default route (lower metric) or stop routing over this VLAN, then it can be removed."
		return 1
	fi
	ROUTE_METRICS=""
	if [ "$VLAN_ROUTES" = true ]; then
		local snap_metric
		ROUTE_METRICS=$(plan_route_metrics "$(backend_owned_metrics)" "$target" "$additions" "$VLAN_ROUTE_METRIC_START")
		snap_metric=$(snapshot_default_metric)
		if [ "$(metric_conflict "$snap_metric" "$ROUTE_METRICS")" = CONFLICT ]; then
			log err "VLAN_ROUTES metric conflict: uplink default (${snap_iface:-?}) has metric ${snap_metric} but assigned VLAN metrics [${ROUTE_METRICS}] would match or beat it; raise VLAN_ROUTE_METRIC_START above the uplink metric. Refusing to apply, changing nothing"
			return 1
		fi
	fi
	[ -f "$NETPLAN_FILE" ] && had_prior=1
	if ! backup_current; then
		log err "cannot back up current $NETPLAN_FILE (disk full or $BACKUP_DIR unwritable); refusing to apply"
		return 1
	fi
	if ! backend_generate_config "$target"; then
		log err "failed to write $NETPLAN_FILE"
		restore_prior "$had_prior"
		return 1
	fi
	if ! backend_validate ""; then
		if [ "$VALIDATE_ERRSRC" = base ]; then
			log err "netplan generate failed on a BASE netplan file (NOT dynavlan's); dynavlan updates are frozen until the base config is fixed: $VALIDATE_ERRMSG"
		else
			log err "netplan generate rejected dynavlan's own config: $VALIDATE_ERRMSG"
		fi
		restore_prior "$had_prior"
		return 1
	fi
	local trunks
	trunks=$(distinct_ifaces "$target")
	log info "applying target [${target:-none}] on trunks [${trunks:-none}] via netplan try (uplink snapshot: ${snap_iface:-none})"
	if backend_apply_with_revert "$snap_iface" "$probe"; then
		log notice "netplan try ACCEPTED"
		prune_backups
		# ip link delete only AFTER accept; on revert the stale links are harmless
		# but deleting them would lose monitoring on VLANs the revert just restored.
		# M5: a delete that fails here is recorded, not forgotten - the next
		# reconcile's drain_pending_deletes retries it (ownership-safe).
		for tok in $removals; do backend_remove_vlan "$tok" || record_pending_delete "$tok"; done
		wait_leases "$lease_set"
		restart_targets
		log notice "reconcile applied on [${trunks:-none}]: added [${additions:-none}] removed [${removals:-none}]"
		return 0
	fi
	log err "post-apply health check FAILED; netplan try reverted; uplink preserved, no deletes, no restarts"
	restore_prior "$had_prior"
	return 1
}

# ---------------------------------------------------------------------------
# Exclusion / overlap / count warnings (FR-10/11/12)
# ---------------------------------------------------------------------------

log_exclusions() { # IFACE DETECTED_IDS MANAGED_IDS
	local iface="$1" detected="$2" mset=" $3 " id
	for id in $detected; do
		case "$mset" in *" $id "*) log warning "VLAN $id on $iface detected but managed elsewhere; excluded" ;; esac
	done
}

warn_overlap() { # OWNED_TOKENS - FR-11: warn when an owned iface.id is also defined elsewhere
	local owned="$1" tok n ids
	[ -z "$owned" ] && return 0
	ids=$(netplan get network.vlans 2>/dev/null | grep -E '^[[:space:]]+[a-zA-Z0-9_.-]+\.[0-9]+:' | sed 's/^[[:space:]]*//' | sed 's/:$//')
	for tok in $owned; do
		n=$(printf '%s\n' $ids | grep -cx "$tok")
		[ "$n" -ge 2 ] && log warning "dynavlan VLAN $tok also defined in another netplan file (FR-11); keeping dynavlan's entry"
	done
	return 0
}

gate_vlan_count() { # KEPT ADDITIONS - echoes the (possibly reduced) additions; rc 1 = refuse (FR-12/FR-36)
	local kept="$1" adds="$2" nk na n slots newadds dropped
	nk=$(count_ids "$kept")
	na=$(count_ids "$adds")
	n=$((nk + na))
	case "$(vlan_guard "$n" "$VLAN_WARN" "$VLAN_LIMIT")" in
	OK)
		printf '%s' "$adds"
		return 0
		;;
	WARN)
		log warning "about to configure $n VLANs (> VLAN_WARN=$VLAN_WARN): a wide range on a many-VLAN trunk causes a simultaneous DHCP-DISCOVER burst; consider narrowing VLAN_MIN/VLAN_MAX"
		printf '%s' "$adds"
		return 0
		;;
	OVER)
		# Removals-only change while already over the limit: always allow. The cap
		# gates growth; blocking a shrink would freeze an over-limit box over-limit.
		if [ "$na" -eq 0 ]; then
			log warning "VLAN set ($nk) exceeds VLAN_LIMIT=$VLAN_LIMIT but this change adds nothing (removals-only); allowing the shrink"
			printf '%s' "$adds"
			return 0
		fi
		if [ "$VLAN_LIMIT_MODE" = fill ]; then
			# Fill: keep everything owned, add the lowest ids into the remaining
			# slots (deterministic across the fleet), and name every skipped VLAN
			# so the monitoring gap is visible in the journal, not silent.
			slots=$((VLAN_LIMIT - nk))
			[ "$slots" -lt 0 ] && slots=0
			newadds=$(limit_fill "$adds" "$slots")
			dropped=$(set_minus "$adds" "$newadds")
			log warning "VLAN_LIMIT=$VLAN_LIMIT reached (would be $n): adding $(count_ids "$newadds") of $na detected; NOT monitoring [${dropped:-none}] (VLAN_LIMIT_MODE=fill). Narrow VLAN_MIN/VLAN_MAX, extend VLAN_IGNORE, or raise VLAN_LIMIT"
			printf '%s' "$newadds"
			return 0
		fi
		log err "VLAN_LIMIT exceeded: target set would be $n VLANs (> VLAN_LIMIT=$VLAN_LIMIT); refusing to apply, changing nothing. Narrow VLAN_MIN/VLAN_MAX, extend VLAN_IGNORE, or raise VLAN_LIMIT (0 = unlimited). Detection likely indicates a misconfigured range or a core trunk"
		return 1
		;;
	esac
}

# ---------------------------------------------------------------------------
# Reconcile modes (FR-21/22/23/25)
# ---------------------------------------------------------------------------

do_boot() {
	log info "run start: dynavlan $(version_string "$ver" "$build") mode=boot detect=$DETECT_METHOD range=$VLAN_MIN-$VLAN_MAX ignore=[${IGNORE_SET:-none}] reset_on_boot=$RESET_ON_BOOT remove_on_carrier_loss=$REMOVE_ON_CARRIER_LOSS"
	drain_pending_deletes # M5: retry any delete a prior run recorded as failed

	# Do NOT branch on run_detection's rc. It has exactly one non-zero return and it
	# fires precisely when DETECTED_TRUNKS is empty; there is no probe-error signal
	# to tell a real failure from a quiet wire. Aborting on it would abort on the
	# very case FR-41 exists for - every owned trunk unplugged, so nothing is left
	# to detect - and would print "detection failed" for an ordinary quiet trunk.
	# Branch on DETECTED_TRUNKS below instead: same fact, stated honestly.
	run_detection || :
	# Empty detection (ran OK, saw nothing) is NOT a hard failure. Additions become
	# impossible, but an owned trunk that is carrier-down must still be prunable:
	# FR-22's "detected nothing != remove everything" guards the SNIFF signal on the
	# detection-diff path, and carrier is a separate authoritative signal. The in-loop
	# empty-detection guard below still preserves every carrier-UP trunk, so the
	# detection-diff path keeps its FR-22 protection either way.
	if [ -z "$DETECTED_TRUNKS" ] && [ "$REMOVE_ON_CARRIER_LOSS" != true ]; then
		log err "boot reconcile aborted: no carrier / no tags / zero VLANs detected and REMOVE_ON_CARRIER_LOSS=false. Changing nothing (FR-22 zero-detection guard)"
		return 0
	fi
	[ -z "$DETECTED_TRUNKS" ] && log info "boot: zero VLANs detected; owned carrier-down trunks remain eligible for removal"

	local owned owned_ifaces trunk pruned_ifaces=""
	local all_additions="" all_removals="" target any_owned_down=false
	owned=$(backend_owned_vlans)
	owned_ifaces=$(distinct_ifaces "$owned")

	local all_trunks
	all_trunks=$(printf '%s\n' $owned_ifaces $DETECTED_TRUNKS | sort -u | tr '\n' ' ' | sed 's/ $//')

	for trunk in $all_trunks; do
		local detected_ids managed owned_on_trunk owned_ids additions_ids
		detected_ids=$(emit_set $(iface_tags "$trunk"))
		managed=$(backend_list_managed_vlans "$trunk")
		owned_on_trunk=$(tokens_for_iface "$owned" "$trunk")
		owned_ids=$(untag_tokens "$owned_on_trunk")

		log_exclusions "$trunk" "$detected_ids" "$managed"
		additions_ids=$(compute_candidates "$detected_ids" "$VLAN_MIN" "$VLAN_MAX" "$IGNORE_SET" "$managed" "$owned_ids")
		all_additions="$all_additions $(tag_tokens "$trunk" "$additions_ids")"

		eval "_p1_$(iface_key "$trunk")=\"\$detected_ids\""
		eval "_v1_$(iface_key "$trunk")=\"\$(iface_valid "$trunk")\"" # H1: pass-1 removal-trust

		local c1=down
		has_carrier "$trunk" && c1=up
		eval "_c1_$(iface_key "$trunk")=\"\$c1\""
		if [ "$c1" = down ] && [ -n "$owned_on_trunk" ]; then
			any_owned_down=true
		fi
	done

	# A second settle+resample is needed when RESET_ON_BOOT drives a detection
	# diff, OR when carrier-down removal is armed and some owned trunk is already
	# down at pass 1 (that pass-1 sample is one half of the debounce). When
	# RESET_ON_BOOT=false and every trunk is up, neither applies: no settle, no
	# change - the fast path is unchanged.
	local need_pass2=false
	[ "$RESET_ON_BOOT" = true ] && need_pass2=true
	[ "$REMOVE_ON_CARRIER_LOSS" = true ] && [ "$any_owned_down" = true ] && need_pass2=true

	if [ "$need_pass2" = true ]; then
		# The clamped interval applies only when this settle is actually serving the
		# carrier debounce; a pass 2 that exists purely for the detection diff keeps
		# the configured value.
		local settle="$BOOT_SETTLE_SECONDS"
		if [ "$REMOVE_ON_CARRIER_LOSS" = true ] && [ "$any_owned_down" = true ]; then
			settle="$CARRIER_DEBOUNCE_SECONDS"
		fi
		log info "boot pass 2 in ${settle}s..."
		sleep "$settle"
		# Re-detect only when RESET_ON_BOOT drives the detection-diff path. When pass 2
		# exists solely for the carrier re-sample (RESET_ON_BOOT=false, a trunk down),
		# the carrier-down branch reads /sys + the owned set and never consults
		# detection, so a full ~SNIFF_SECONDS sniff here would be pure boot latency.
		[ "$RESET_ON_BOOT" = true ] && run_detection 2>/dev/null

		local routing_ok=unknown   # have_routing evaluated at most once, lazily
		for trunk in $all_trunks; do
			local p1 p2 v1 v2 c1 c2=down owned_on_trunk owned_ids removals_ids
			eval "p1=\"\${_p1_$(iface_key "$trunk")}\""
			eval "v1=\"\${_v1_$(iface_key "$trunk")}\""
			eval "c1=\"\${_c1_$(iface_key "$trunk")}\""
			owned_on_trunk=$(tokens_for_iface "$owned" "$trunk")
			owned_ids=$(untag_tokens "$owned_on_trunk")
			has_carrier "$trunk" && c2=up

			if [ "$c2" = up ]; then
				# Carrier present at pass 2: detection-diff removal, RESET_ON_BOOT only
				# (unchanged from the pre-feature behavior).
				if [ "$RESET_ON_BOOT" = true ]; then
					p2=$(emit_set $(iface_tags "$trunk"))
					v2=$(iface_valid "$trunk")
					# H1: a detection-diff removal needs BOTH passes to be a trusted sample
					# (no capture-method failure) AND non-empty. A failed sniff/LLDP yields
					# a partial set indistinguishable from real absence, so it must not
					# authorize a removal. An explicit "invalid" means a method FAILED (warn);
					# an empty p1/p2 (incl. a trunk carrier-down at pass 1, so v1 is unset)
					# is a genuine no-sample and preserves quietly.
					if [ "$v1" = invalid ] || [ "$v2" = invalid ]; then
						log warning "trunk $trunk: detection incomplete (a capture method failed) in a boot pass; preserving all owned VLANs (H1 - a failed sniff/LLDP must not authorize removals)"
					elif [ "$v1" = valid ] && [ "$v2" = valid ] && [ -n "$p1" ] && [ -n "$p2" ]; then
						removals_ids=$(boot_removals "$owned_ids" "$p1" "$p2")
						all_removals="$all_removals $(tag_tokens "$trunk" "$removals_ids")"
					else
						log info "trunk $trunk: empty detection in pass 1 or 2; preserving all owned VLANs"
					fi
				fi
				continue
			fi

			# Carrier DOWN at pass 2.
			[ -z "$owned_ids" ] && continue
			if [ "$REMOVE_ON_CARRIER_LOSS" != true ]; then
				log warning "trunk $trunk: no carrier; REMOVE_ON_CARRIER_LOSS=false, preserving owned VLANs"
				continue
			fi
			if [ "$c1" != down ]; then
				log info "trunk $trunk: carrier flapped (up->down) across the settle; preserving owned VLANs"
				continue
			fi
			if [ "$routing_ok" = unknown ]; then
				if have_routing; then routing_ok=yes; else routing_ok=no; fi
			fi
			if [ "$routing_ok" != yes ]; then
				log warning "trunk $trunk: carrier down but box has no healthy routing; preserving owned VLANs (fail toward no change)"
				continue
			fi
			removals_ids=$(carrier_removals "$owned_ids" "$c1" "$c2")
			all_removals="$all_removals $(tag_tokens "$trunk" "$removals_ids")"
			pruned_ifaces="$pruned_ifaces $trunk"
			log notice "trunk $trunk: carrier down across both samples; removing all owned VLANs on it [$removals_ids]"
		done
	fi

	all_additions=$(emit_tokens $all_additions)
	all_removals=$(emit_tokens $all_removals)
	# Additions were computed from pass-1 tags, before the carrier verdict. A trunk
	# that was detected and then went dead would otherwise have new VLANs CREATED on
	# it in the same apply that tears its old ones down - they can never lease, they
	# stall wait_leases, and they trigger a pointless agent restart. Drop them.
	# pruned_ifaces above holds only OWNED trunks the removal path confirmed dead, and
	# only when pass 2 ran; M4 folds in every addition-bearing trunk that is
	# carrier-down now, so a newly-detected but not-yet-owned trunk that died in the
	# window (or any dead trunk on the fast path, where pass 2 never ran) is caught too.
	pruned_ifaces=$(printf '%s\n' $pruned_ifaces $(ifaces_without_carrier "$all_additions") | sort -u | tr '\n' ' ' | sed 's/ $//')
	if [ -n "$pruned_ifaces" ]; then
		local kept_additions dropped
		kept_additions=$(drop_iface_tokens "$all_additions" "$pruned_ifaces")
		dropped=$(set_minus "$all_additions" "$kept_additions")
		[ -n "$dropped" ] && log info "dropping additions on carrier-down trunk(s) [${pruned_ifaces# }]: [$dropped]"
		all_additions="$kept_additions"
	fi
	warn_overlap "$owned"

	if [ -z "$all_additions" ] && [ -z "$all_removals" ]; then
		log info "no change: owned=[${owned:-none}]; zero applies/restarts"
		return 0
	fi

	all_additions=$(gate_vlan_count "$(set_minus "$owned" "$all_removals")" "$all_additions") || return 1
	if [ -z "$all_additions" ] && [ -z "$all_removals" ]; then
		log info "no change after VLAN_LIMIT gating; zero applies/restarts"
		return 0
	fi

	target=$(set_union "$(set_minus "$owned" "$all_removals")" "$all_additions")
	apply_change "$target" "$all_additions" "$all_removals"
}

do_rescan() {
	log info "run start: dynavlan $(version_string "$ver" "$build") mode=rescan detect=$DETECT_METHOD range=$VLAN_MIN-$VLAN_MAX ignore=[${IGNORE_SET:-none}] remove_on_carrier_loss=$REMOVE_ON_CARRIER_LOSS"
	drain_pending_deletes # M5: retry any delete a prior run recorded as failed
	run_detection || : # rc is "saw nothing", not "failed" - see do_boot
	if [ -z "$DETECTED_TRUNKS" ] && [ "$REMOVE_ON_CARRIER_LOSS" != true ]; then
		log info "rescan: no trunks detected; nothing to add"
		return 0
	fi

	local owned owned_ifaces trunk all_additions="" all_removals="" pruned_ifaces=""
	owned=$(backend_owned_vlans)
	owned_ifaces=$(distinct_ifaces "$owned")

	# Additions: carrier-up detected trunks only (unchanged behavior).
	for trunk in $DETECTED_TRUNKS; do
		local detected_ids managed owned_on_trunk owned_ids additions_ids
		detected_ids=$(emit_set $(iface_tags "$trunk"))
		managed=$(backend_list_managed_vlans "$trunk")
		owned_on_trunk=$(tokens_for_iface "$owned" "$trunk")
		owned_ids=$(untag_tokens "$owned_on_trunk")

		log_exclusions "$trunk" "$detected_ids" "$managed"
		additions_ids=$(compute_candidates "$detected_ids" "$VLAN_MIN" "$VLAN_MAX" "$IGNORE_SET" "$managed" "$owned_ids")
		all_additions="$all_additions $(tag_tokens "$trunk" "$additions_ids")"
	done

	# Removals: owned trunks that are carrier-down. Fast path preserved - the
	# settle sleep is incurred ONLY when at least one owned trunk is actually down,
	# so steady state (all trunks up) has no new latency and stays add-only.
	if [ "$REMOVE_ON_CARRIER_LOSS" = true ]; then
		local down_trunks=""
		for trunk in $owned_ifaces; do
			has_carrier "$trunk" || down_trunks="$down_trunks $trunk"
		done
		if [ -n "$down_trunks" ] && have_routing; then
			log info "rescan: owned trunk(s) carrier-down [${down_trunks# }]; confirming over ${CARRIER_DEBOUNCE_SECONDS}s..."
			sleep "$CARRIER_DEBOUNCE_SECONDS"
			# Re-check routing AFTER the settle, not only before it. The uplink can
			# drop DURING the sleep (a switch reboot takes both ports), and nothing
			# downstream would catch it: with the uplink already gone the pre-apply
			# route snapshot is empty, and an empty snapshot is a deliberate
			# unconditional health-check PASS (AC-12, "never revert on an
			# independently-missing uplink"). Without this second check a removal is
			# applied and ACCEPTED on a box with no routing at all - netplan try, an
			# ip link delete, and an agent restart, all during an active outage.
			# do_boot is not exposed: it evaluates have_routing inside its pass-2
			# loop, immediately before building the removal set.
			if ! have_routing; then
				log warning "rescan: routing lost during the settle; preserving carrier-down trunk(s) [${down_trunks# }] (fail toward no change)"
			else
				for trunk in $down_trunks; do
					local owned_ids c2=down removals_ids
					owned_ids=$(untag_tokens "$(tokens_for_iface "$owned" "$trunk")")
					has_carrier "$trunk" && c2=up
					removals_ids=$(carrier_removals "$owned_ids" down "$c2")
					if [ -n "$removals_ids" ]; then
						all_removals="$all_removals $(tag_tokens "$trunk" "$removals_ids")"
						pruned_ifaces="$pruned_ifaces $trunk"
						log notice "rescan: trunk $trunk carrier down across both samples; removing [$removals_ids]"
					else
						log info "rescan: trunk $trunk carrier recovered during the settle; preserving owned VLANs"
					fi
				done
			fi
		elif [ -n "$down_trunks" ]; then
			log warning "rescan: carrier-down trunk(s) [${down_trunks# }] but no healthy routing; preserving (fail toward no change)"
		fi
	fi

	all_additions=$(emit_tokens $all_additions)
	all_removals=$(emit_tokens $all_removals)
	# Additions came from the sniff, which filtered carrier once at its start and
	# then ran for SNIFF_SECONDS; a trunk that died mid-sniff kept its tags and is
	# still in DETECTED_TRUNKS. Without this it would gain new VLANs in the very
	# apply that tears its old ones down. See the matching guard in do_boot.
	# pruned_ifaces above holds only OWNED trunks the removal path confirmed dead;
	# M4 folds in every addition-bearing trunk that is carrier-down now, catching a
	# newly-detected but not-yet-owned trunk that died in the window (down_trunks is
	# built from owned_ifaces only, so it never sees an unowned trunk).
	pruned_ifaces=$(printf '%s\n' $pruned_ifaces $(ifaces_without_carrier "$all_additions") | sort -u | tr '\n' ' ' | sed 's/ $//')
	if [ -n "$pruned_ifaces" ]; then
		local kept_additions dropped
		kept_additions=$(drop_iface_tokens "$all_additions" "$pruned_ifaces")
		dropped=$(set_minus "$all_additions" "$kept_additions")
		[ -n "$dropped" ] && log info "rescan: dropping additions on carrier-down trunk(s) [${pruned_ifaces# }]: [$dropped]"
		all_additions="$kept_additions"
	fi
	if [ -z "$all_additions" ] && [ -z "$all_removals" ]; then
		log info "rescan: no changes (owned=[${owned:-none}]); zero applies/restarts"
		return 0
	fi

	warn_overlap "$owned"
	all_additions=$(gate_vlan_count "$(set_minus "$owned" "$all_removals")" "$all_additions") || return 1
	if [ -z "$all_additions" ] && [ -z "$all_removals" ]; then
		log info "rescan: no changes after VLAN_LIMIT gating; zero applies/restarts"
		return 0
	fi

	local target
	target=$(set_union "$(set_minus "$owned" "$all_removals")" "$all_additions")
	apply_change "$target" "$all_additions" "$all_removals"
}

# ---------------------------------------------------------------------------
# Operator entrypoints (FR-34/35, --reconfigure)
# ---------------------------------------------------------------------------

do_dryrun() {
	log info "dry-run: detecting (no changes will be made)..."
	run_detection || : # rc is "saw nothing", not "failed" - see do_boot
	if [ -z "$DETECTED_TRUNKS" ] && [ "$REMOVE_ON_CARRIER_LOSS" != true ]; then
		printf 'dry-run: no trunks detected; would change nothing\n'
		return 0
	fi

	local owned trunk all_additions="" all_removals=""
	owned=$(backend_owned_vlans)
	local owned_ifaces
	owned_ifaces=$(distinct_ifaces "$owned")
	local all_trunks
	all_trunks=$(printf '%s\n' $owned_ifaces $DETECTED_TRUNKS | sort -u | tr '\n' ' ' | sed 's/ $//')

	local routing_ok=no
	have_routing && routing_ok=yes

	for trunk in $all_trunks; do
		local detected_ids managed owned_on_trunk owned_ids additions_ids removals_ids
		detected_ids=$(emit_set $(iface_tags "$trunk"))
		managed=$(backend_list_managed_vlans "$trunk")
		owned_on_trunk=$(tokens_for_iface "$owned" "$trunk")
		owned_ids=$(untag_tokens "$owned_on_trunk")

		additions_ids=$(compute_candidates "$detected_ids" "$VLAN_MIN" "$VLAN_MAX" "$IGNORE_SET" "$managed" "$owned_ids")
		all_additions="$all_additions $(tag_tokens "$trunk" "$additions_ids")"

		# Mirror do_boot's detection-diff conditions exactly, or the preview reports
		# a teardown --boot would never perform. Boot runs this branch only on a
		# carrier-UP trunk (carrier-down is FR-41's business, below) and only with a
		# non-empty detection in both passes; a down or tagless trunk sniffs nothing,
		# so an unguarded set_minus against an empty set dumps its whole owned set
		# into removals.
		if [ "$RESET_ON_BOOT" = true ] && has_carrier "$trunk" && [ -n "$detected_ids" ]; then
			removals_ids=$(set_minus "$owned_ids" "$detected_ids")
			all_removals="$all_removals $(tag_tokens "$trunk" "$removals_ids")"
		fi

		if [ "$REMOVE_ON_CARRIER_LOSS" = true ] && [ "$routing_ok" = yes ] \
			&& ! has_carrier "$trunk" && [ -n "$owned_ids" ]; then
			all_removals="$all_removals $(tag_tokens "$trunk" "$owned_ids")"
		fi
	done

	all_additions=$(emit_tokens $all_additions)
	all_removals=$(emit_tokens $all_removals)
	# M4 preview parity: boot/rescan drop additions on any addition-bearing trunk
	# that is carrier-down now, so reflect that here or the preview over-lists an
	# addition the real run would skip (same discipline as the removal preview above).
	local pruned_ifaces
	pruned_ifaces=$(ifaces_without_carrier "$all_additions")
	[ -n "$pruned_ifaces" ] && all_additions=$(drop_iface_tokens "$all_additions" "$pruned_ifaces")
	local target
	target=$(set_union "$(set_minus "$owned" "$all_removals")" "$all_additions")

	printf 'dry-run diff (boot mode, single detection pass):\n'
	printf '  trunks:    [%s]\n' "${all_trunks:-none}"
	printf '  owned:     [%s]\n' "${owned:-none}"
	printf '  additions: [%s]\n' "${all_additions:-none}"
	printf '  removals:  [%s]  (indicative; boot confirms with a 2-pass sniff or a 2-sample carrier check)\n' "${all_removals:-none}"
	printf '  target:    [%s]\n' "${target:-none}"
	printf '  count gate: %s (%s VLANs; VLAN_WARN=%s VLAN_LIMIT=%s mode=%s)\n' \
		"$(vlan_guard "$(count_ids "$target")" "$VLAN_WARN" "$VLAN_LIMIT")" \
		"$(count_ids "$target")" "$VLAN_WARN" "$VLAN_LIMIT" "$VLAN_LIMIT_MODE"

	for trunk in $all_trunks; do
		local detected_ids t_owned t_adds t_rems cstate
		detected_ids=$(emit_set $(iface_tags "$trunk"))
		t_owned=$(tokens_for_iface "$owned" "$trunk")
		t_adds=$(tokens_for_iface "$all_additions" "$trunk")
		t_rems=$(tokens_for_iface "$all_removals" "$trunk")
		cstate=down
		has_carrier "$trunk" && cstate=up
		printf '  %s: carrier=%s detected=[%s] owned=[%s] +[%s] -[%s]\n' \
			"$trunk" "$cstate" "${detected_ids:-none}" "${t_owned:-none}" "${t_adds:-none}" "${t_rems:-none}"
	done

	# C1 preview: mirror apply_change's default-route guard so the diff above is not
	# misleading (a removal the apply would actually refuse).
	local dry_snap
	dry_snap=$(snapshot_default_route)
	if default_iface_in_removals "$dry_snap" "$all_removals"; then
		printf '  default-route guard: current default iface (%s) is in removals; --boot/--rescan would REFUSE and change nothing (C1: removing it would strand the default egress). Move the default (lower metric) or stop routing over this VLAN first.\n' "$dry_snap"
	fi

	if [ "$REMOVE_ON_CARRIER_LOSS" = true ] && [ "$routing_ok" = no ]; then
		printf '  carrier-down: preserving (no healthy default route; --boot would preserve)\n'
	fi

	# M5 preview: a prior run may have failed to delete an already-removed interface
	# and recorded it; --boot/--rescan would retry the delete. Read-only here.
	local pend
	pend=$(pending_deletes)
	[ -n "$pend" ] && printf '  pending re-delete (prior removal left the live interface up; --boot/--rescan would retry): [%s]\n' "$pend"

	if [ "$RESTART_ON_NEW_SUBNET" = true ]; then
		local cur_sn new_sn
		cur_sn=$(current_subnets)
		new_sn=$(set_minus "$cur_sn" "$(read_seen)")
		printf '  new IPv4 subnets since last seen (would restart): [%s]\n' "${new_sn:-none}"
	fi

	ROUTE_METRICS=""
	if [ "$VLAN_ROUTES" = true ]; then
		local snap_metric
		ROUTE_METRICS=$(plan_route_metrics "$(backend_owned_metrics)" "$target" "$all_additions" "$VLAN_ROUTE_METRIC_START")
		snap_metric=$(snapshot_default_metric)
		printf '  routes:    ON start=%s metrics [%s]\n' "$VLAN_ROUTE_METRIC_START" "${ROUTE_METRICS:-none}"
		if [ "$(metric_conflict "$snap_metric" "$ROUTE_METRICS")" = CONFLICT ]; then
			printf '  routes:    CONFLICT - uplink default metric %s would be matched/beaten; --boot would refuse (raise VLAN_ROUTE_METRIC_START)\n' "$snap_metric"
		fi
	fi

	local tree saved
	tree=$(mktemp -d /run/dynavlan.dryrun.XXXXXX) || tree=""
	if [ -z "$tree" ]; then
		printf '  validate:  SKIPPED - cannot create scratch tree in /run\n'
		return 1
	fi
	mkdir -p "$tree/etc/netplan"
	cp -a /etc/netplan/. "$tree/etc/netplan/" 2>/dev/null
	saved="$NETPLAN_FILE"
	NETPLAN_FILE="$tree/etc/netplan/90-dynavlan.yaml"
	if ! backend_generate_config "$target"; then
		NETPLAN_FILE="$saved"
		printf '  validate:  SKIPPED - could not write candidate config into the throwaway tree\n'
		rm -rf "$tree"
		return 1
	fi
	NETPLAN_FILE="$saved"
	# A failed validation must exit non-zero: --dry-run is the attended pre-flight,
	# and a caller (operator or script) that checks $? has to be able to see the
	# FAIL, not just read it in the printed output.
	local vstatus=0
	if backend_validate "$tree"; then
		printf '  validate:  OK\n'
	elif [ "$VALIDATE_ERRSRC" = base ]; then
		printf '  validate:  FAIL - a BASE netplan file is invalid (not dynavlan): %s\n' "$VALIDATE_ERRMSG"
		vstatus=1
	else
		printf '  validate:  FAIL - dynavlan config invalid: %s\n' "$VALIDATE_ERRMSG"
		vstatus=1
	fi
	rm -rf "$tree"
	printf '  (dry-run only: no netplan try, no apply, no restart)\n'
	return "$vstatus"
}

# FR-39: regenerate the OWNED set with the current build and apply only if the
# generated body actually differs from what is on disk.
#
# Deliberately runs NO detection. If it detected and trunk selection landed on a
# different NIC, "reapply" would silently become a trunk RELOCATION - every VLAN
# renamed onto another parent - with none of boot's two-pass evidence and no
# cleanup of the abandoned links. Pinning to the owned parent also makes this fast
# and carrier-independent, which is what an operator invoking it by hand wants.
do_reapply() {
	local owned parents live generated saved tmpdir hdr rc
	owned=$(backend_owned_vlans)
	if [ -z "$owned" ]; then
		log notice "reapply: no VLANs owned; nothing to regenerate"
		return 0
	fi
	parents=$(distinct_ifaces "$owned")
	if [ -z "$parents" ]; then
		log err "reapply: $NETPLAN_FILE defines VLANs but no parent link; refusing - run --boot to reconcile from detection instead"
		return 1
	fi
	log info "run start: dynavlan $(version_string "$ver" "$build") mode=reapply owned=[$owned] trunks=[$parents]"

	live=$(cat "$NETPLAN_FILE" 2>/dev/null)
	hdr=$(printf '%s\n' "$live" | head -1)
	case "$hdr" in
	*"Managed by dynavlan"*) log info "on-disk config header: ${hdr#\# Managed by }" ;;
	esac

	tmpdir=$(mktemp -d /run/dynavlan.reapply.XXXXXX) || {
		log err "reapply: cannot create scratch dir in /run; refusing"
		return 1
	}
	ROUTE_METRICS=""
	if [ "$VLAN_ROUTES" = true ]; then
		ROUTE_METRICS=$(plan_route_metrics "$(backend_owned_metrics)" "$owned" "" "$VLAN_ROUTE_METRIC_START")
	fi
	saved="$NETPLAN_FILE"
	NETPLAN_FILE="$tmpdir/90-dynavlan.yaml"
	if ! backend_generate_config "$owned"; then
		NETPLAN_FILE="$saved"
		rm -rf "$tmpdir"
		log err "reapply: could not generate a candidate config; nothing changed"
		return 1
	fi
	generated=$(cat "$NETPLAN_FILE" 2>/dev/null)
	NETPLAN_FILE="$saved"
	rm -rf "$tmpdir"
	if [ -z "$generated" ]; then
		log err "reapply: generated a candidate config but could not read it back; refusing, nothing applied"
		return 1
	fi
	if [ "$(config_body_differs "$generated" "$live")" = SAME ]; then
		log notice "reapply: on-disk config already matches what this build generates; no change, nothing applied"
		return 0
	fi
	log notice "reapply: config drift detected ($(count_ids "$owned") VLANs owned; VLAN_WARN=$VLAN_WARN VLAN_LIMIT=$VLAN_LIMIT); applying regenerated config"
	apply_change "$owned" "" "" "$owned"
	rc=$?
	[ "$rc" -eq 0 ] && log notice "reapply: applied regenerated config for [$owned] on trunks [$parents]"
	return $rc
}

do_status() { # FR-35 - report all trunks
	local owned trunks managed
	owned=$(backend_owned_vlans)
	trunks=$(distinct_ifaces "$owned")
	printf 'dynavlan %s\n' "$(version_string "$ver" "$build")"
	printf '  configured (owned): [%s]\n' "${owned:-none}"
	printf '  owned trunks: [%s]\n' "${trunks:-none}"
	if [ -n "$trunks" ]; then
		local t cstate
		for t in $trunks; do
			if has_carrier "$t"; then cstate=up; else cstate=down; fi
			printf '    %s: carrier=%s\n' "$t" "$cstate"
		done
	fi
	printf '  detect_method: %s   range: %s-%s   ignore: [%s]\n' "$DETECT_METHOD" "$VLAN_MIN" "$VLAN_MAX" "${IGNORE_SET:-none}"
	log info "status: running a ${SNIFF_SECONDS}s detection pass..."
	if run_detection && [ -n "$DETECTED_TRUNKS" ]; then
		printf '  detected trunks: [%s]\n' "$DETECTED_TRUNKS"
		local trunk
		for trunk in $DETECTED_TRUNKS; do
			local detected_ids
			detected_ids=$(emit_set $(iface_tags "$trunk"))
			managed=$(backend_list_managed_vlans "$trunk")
			printf '    %s: detected=[%s] managed-elsewhere=[%s]\n' "$trunk" "$detected_ids" "${managed:-none}"
		done
	else
		printf '  detected trunks: [none]\n'
	fi
	printf '  run history: journalctl -t dynavlan\n'
	if [ "$RESTART_ON_NEW_SUBNET" = true ]; then
		local cur_sn new_sn
		cur_sn=$(current_subnets)
		new_sn=$(set_minus "$cur_sn" "$(read_seen)")
		printf '  new IPv4 subnets since last seen (would restart): [%s]\n' "${new_sn:-none}"
	fi
	return 0
}

# Pure: the timer drop-in text for a given rescan interval (minutes).
#
# The reset line is load-bearing and so is its blast radius: an empty assignment
# to ANY On*Sec= clears the ENTIRE monotonic timer list, not just the option
# being assigned. Clearing OnUnitActiveSec therefore also drops the base unit's
# first-fire trigger, and this drop-in has to restate it. Rendering the interval
# alone left the timer anchored solely on OnUnitActiveSec, which needs a PREVIOUS
# activation to anchor on; with none it never elapses. Hardware-validated failure
# (2026-07-25): timer active, Result=success, never triggered, next_elapse=0,
# NextElapseUSecMonotonic=infinity - a rescan timer that silently never runs.
#
# First fire is OnActiveSec (relative to timer activation), not OnBootSec
# (relative to kernel boot): install.sh stops and restarts the timer on upgrade,
# by which point any boot-relative deadline is already in the past. OnActiveSec
# covers both cases, since at boot the timer activates at roughly boot time.
render_timer_dropin() { # RESCAN_MINUTES -> drop-in file contents
	local first_fire=2 # minutes after timer activation before the first rescan
	printf '# Rendered by dynavlan --reconfigure from RESCAN_MINUTES. Do not edit.\n'
	printf '[Timer]\n'
	printf '# An empty On*Sec= resets the ENTIRE monotonic timer list (not just the option\n'
	printf '# assigned), so every trigger the base unit declares must be restated here.\n'
	printf 'OnUnitActiveSec=\n'
	printf 'OnActiveSec=%smin\n' "$first_fire"
	printf 'OnUnitActiveSec=%smin\n' "$1"
}

do_reconfigure() { # render the timer interval drop-in from RESCAN_MINUTES
	local dropdir="/etc/systemd/system/dynavlan.timer.d"
	mkdir -p "$dropdir" 2>/dev/null || {
		log err "cannot create $dropdir"
		return 1
	}
	render_timer_dropin "$RESCAN_MINUTES" >"$dropdir/interval.conf" || {
		log err "failed to write $dropdir/interval.conf"
		return 1
	}
	systemctl daemon-reload 2>/dev/null
	log notice "timer interval set to ${RESCAN_MINUTES}min ($dropdir/interval.conf)"
	return 0
}

# ---------------------------------------------------------------------------
# Entrypoint
# ---------------------------------------------------------------------------

main() {
	local mode="${1:-}" rc
	case "$mode" in
	--boot | --rescan | --reapply | --dry-run | --status | --reconfigure) ;;
	--version | -V)
		# Answered before the config load and the root check on purpose: "what is
		# installed here" must stay answerable when the config is invalid or the
		# caller is unprivileged, since those are exactly the moments the question
		# gets asked. Goes to stdout, not the log.
		printf 'dynavlan %s\n' "$(version_string "$ver" "$build")"
		return 0
		;;
	'' | -h | --help)
		usage
		return 2
		;;
	*)
		printf 'unknown mode: %s\n' "$mode" >&2
		usage
		return 2
		;;
	esac

	load_config || {
		log err "invalid configuration; refusing to run"
		return 1
	}

	case "$mode" in
	--status)
		# Root required: detection needs link-up/promisc/tcpdump; unprivileged it
		# would silently fail every probe and report a confidently wrong "no trunk".
		[ "$(id -u)" -eq 0 ] || {
			log err "must run as root"
			return 1
		}
		do_status
		return $?
		;;
	--reconfigure)
		[ "$(id -u)" -eq 0 ] || {
			log err "must run as root"
			return 1
		}
		do_reconfigure
		return $?
		;;
	esac

	check_preconditions || return 1

	case "$mode" in
	--dry-run)
		# Take the run lock if free and hold it for the preview, so a timer rescan
		# cannot start applying mid-preview (it skips per FR-30 and retries next
		# cycle). If a run already holds it, do NOT block the operator: warn that
		# the preview may reflect mid-change state and continue (dry-run is read-only).
		if exec 8>"$LOCK_FILE" 2>/dev/null; then
			flock -n 8 || log warning "a boot/rescan run is in progress; dry-run preview may reflect mid-change state"
		fi
		do_dryrun
		return $?
		;;
	--reapply)
		# Blocks rather than skipping. --boot/--rescan are scheduled and simply run
		# again next cycle, so "skipped" is harmless there; --reapply is an operator
		# typing a command, and returning rc 0 without applying would read as success.
		exec 8>"$LOCK_FILE" || {
			log err "cannot open lock $LOCK_FILE"
			return 1
		}
		if ! flock -w "$REAPPLY_LOCK_WAIT" 8; then
			log err "another dynavlan run still holds $LOCK_FILE after ${REAPPLY_LOCK_WAIT}s; nothing applied. Wait for it to finish (or stop dynavlan.timer) and re-run"
			return 1
		fi
		do_reapply
		rc=$?
		log info "run end: mode=reapply rc=$rc"
		return $rc
		;;
	--boot | --rescan)
		# FR-30: serialize on an fd-held flock (kernel-released on death).
		exec 8>"$LOCK_FILE" || {
			log err "cannot open lock $LOCK_FILE"
			return 1
		}
		if ! flock -n 8; then
			log info "skipped, run in progress"
			return 0
		fi
		if [ "$mode" = --boot ]; then do_boot; else do_rescan; fi
		rc=$?
		maybe_restart_on_new_subnet
		log info "run end: mode=${mode#--} rc=$rc"
		return $rc
		;;
	esac
}

# Run main only when executed, not when sourced.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
